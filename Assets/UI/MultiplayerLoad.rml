<rml>
<head>
	<title>MultiplayerLoad</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="LoadScreen.rcss"/>
	<link type="text/rcss" href="MultiplayerLoad.rcss"/>
</head>
<body class="screen ld ld-concept" data-model="multiplayerload">
	<loadbackdrop class="ld-art"></loadbackdrop>
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<div class="screen-frame ld-frame">
		<div class="ld-head">
			<div class="ld-heading">
				<div class="overline accent-overline ld-mode">{{game_mode}}</div>
				<div class="ld-title">{{map_display_name}}</div>
				<div class="ld-loading pulse"><gametext key="GUI:Loading"/></div>
			</div>
			<div class="spacer"></div>
				<div class="ld-general" data-if="local_name != ''">
					<div class="ld-portrait" data-if="has_portrait"><mappedimage data-attr-name="local_portrait"/></div>
					<div class="ld-general-text">
						<div class="ld-general-name">{{local_name}}</div>
						<div class="ld-general-features"><div class="ld-feature-line" data-for="feature : local_feature_lines"><span class="ld-feature-bullet">&#8226;</span><span>{{feature}}</span></div></div>
					</div>
				</div>
		</div>

		<div class="ld-mid">
            <div class="ld-tip-card" data-if="has_tip">
                <div class="ld-tip-faction">{{tip_faction}}</div>
                <div class="ld-tip-heading">
                    <div class="ld-tip-icon" data-if="has_tip_image"><mappedimage data-attr-name="tip_image"/></div>
                    <div class="ld-tip-title">{{tip_title}}</div>
                    <div class="ld-tip-cost" data-if="has_tip_cost">{{tip_cost}}</div>
                </div>
                <div class="ld-tip-advice">{{tip_advice}}</div>
                <div class="ld-tip-game" data-if="tip_description != ''">
                    <div class="ld-tip-game-label">IN-GAME DESCRIPTION</div>
                    <div class="ld-tip-description">{{tip_description}}</div>
                </div>
                <div class="ld-tip-author" data-if="tip_author != ''">BY {{tip_author}}</div>
            </div>
            <div class="spacer"></div>
			<div class="surface ld-map-card" data-if="has_map">
				<div class="map-frame ld-map-frame">
					<mappreview class="map-image" data-attr-map="map_name">
						<div data-for="marker : markers">
							<div class="marker" data-if="marker.used" data-style-left="marker.x_style" data-style-top="marker.y_style">
								<div class="marker-dot" data-style-border-color="marker.has_label ? marker.color_hex : '#FFFFFF78'">{{marker.has_label ? marker.label : ''}}</div>
							</div>
						</div>
					</mappreview>
				</div>
			</div>
		</div>

			<!-- One card per player along the bottom: colour, badge, name, army, team, progress. -->
			<div class="ld-cards">
				<div class="ld-card" data-for="row : rows" data-if="row.used" data-style-border-top-color="row.color_hex">
						<div class="ld-card-top">
							<div class="pc-badge ld-badge"><mappedimage data-if="row.has_side_image" data-attr-name="row.side_image"/><span data-if="!row.has_side_image">?</span></div>
						</div>
						<div class="ld-name">{{row.name}}</div>
						<div class="ld-army-line"><div class="ld-army">{{row.side}}</div><div class="chip-label ld-team">{{row.team}}</div></div>
						<div class="progress ld-player-bar" data-class-invisible="!row.show_progress"><div class="progress-fill" data-style-width="row.progress_style" data-style-background-color="row.color_hex"></div></div>
				</div>
			</div>
	</div>
</body>
</rml>
