

body.ss
{
	background-color: #0E0F10;
}


.ss-art
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	overflow: hidden;
	clip: always;
}

.ss-cover-art
{
	display: block;
	position: absolute;
	left: 0;
	top: 50%;
	width: 100vw;
	height: 75vw;
	margin-top: -37.5vw;
}

.ss-scrim
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#0E0F10A6 #0E0F10E0);
}



.ss-heading .hq-title
{
	flex-shrink: 0;
	color: #FFFFFF;
}

.ss-heading.victory .hq-title
{
	color: #D1FD04;
}

.ss-heading.defeat .hq-title
{
	color: #FF5050;
	border-left-color: #FF5050;
}

.hq-aside.ss-match
{
	align-self: stretch;
	min-width: 0;
	flex-shrink: 1;
}

.hq-aside.ss-match > *
{
	margin-left: 0;
}

.ss-fact
{
	display: flex;
	flex-direction: column;
	justify-content: center;
	min-width: 0;
	padding: 0 24dp;
	max-width: 480dp;
	border-left: 1dp #898A8B28;
}

.ss-fact:first-child
{
	border-left-width: 0;
}

.ss-fact-value
{
	display: block;
	margin-top: 2dp;
	font-size: 24dp;
	font-weight: bold;
	color: #F1F2F3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}


.ss-highlights
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	margin-bottom: 20dp;
}


.ss-hl-slot
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-left: 20dp;
}

.ss-hl-slot:first-child
{
	margin-left: 0;
}

.ss-hl
{
	display: block;
	padding: 16dp 20dp 16dp 20dp;
	background-color: #0E0F10E0;
	border-top: 4dp #7A7B7C;
}

.ss-hl .overline
{
	overflow: hidden;
	text-overflow: ellipsis;
}

.ss-hl-value
{
	display: block;
	margin-top: 4dp;
	font-size: 40dp;
	line-height: 46dp;
	font-weight: bold;
	color: #D1FD04;
}

.ss-hl-name
{
	display: block;
	font-size: 18dp;
	font-weight: bold;
	color: #DCDDDE;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ss-hl-dot
{
	display: inline-block;
	width: 10dp;
	height: 10dp;
	margin-right: 8dp;
	vertical-align: middle;
}


.surface.ss-table
{
	display: flex;
	flex-direction: column;
	flex: 0 1 auto;
	min-height: 0;
	padding: 6dp 20dp 12dp 20dp;
}


.list-head.ss-head
{
	height: auto;
	min-height: 58dp;
	padding: 6dp 16dp 8dp 22dp;
	align-items: flex-end;
}

.ss-head .ss-cell
{
	font-size: 15dp;
	line-height: 18dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #8A8B8C;
	white-space: normal;
}


.ss-rows
{
	flex: 0 1 auto;
	max-height: 490dp;
}

.ss-row-slot
{
	display: block;
}

.ss-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 56dp;
	margin-top: 5dp;
	padding: 0 16dp 0 16dp;
	background-color: #111213B4;
	border-left: 6dp #7A7B7C;
}

.ss-row.local
{
	background-color: #1B1C1DE6;
}

.ss-row.observer
{
	height: 46dp;
	background-color: #0E0F108C;
	border-left-color: #898A8B28;
}

.ss-who
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 2.4 1 0%;
	min-width: 0;
	padding-right: 12dp;
}

.ss-head .ss-who
{
	align-self: flex-end;
}

.pc-badge.ss-badge
{
	flex: 0 0 44dp;
	width: 44dp;
	height: 44dp;
	margin-right: 14dp;
	line-height: 42dp;
}

.ss-badge mappedimage
{
	width: 36dp;
	height: 36dp;
	margin: 3dp;
}

.observer .pc-badge.ss-badge
{
	flex-basis: 36dp;
	width: 36dp;
	height: 36dp;
	line-height: 34dp;
	opacity: 0.6;
}

.observer .ss-badge mappedimage
{
	width: 28dp;
	height: 28dp;
	margin: 3dp;
}

.ss-name-wrap
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 0%;
	min-width: 0;
}

.ss-name
{
	display: block;
	flex: 0 1 auto;
	min-width: 0;
	font-size: 22dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.observer .ss-name
{
	font-size: 19dp;
	font-weight: normal;
	color: #B1B2B3;
}

.ss-tags
{
	display: block;
	flex: 0 0 auto;
	margin-left: 12dp;
	white-space: nowrap;
}

.ss-tags .chip-label
{
	font-size: 12dp;
	padding: 0 8dp;
	margin-right: 6dp;
}

.ss-cell
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	padding-left: 8dp;
	text-align: right;
	font-size: 24dp;
	font-weight: bold;
	color: #DCDDDE;
	white-space: nowrap;
}

.observer .ss-cell
{
	font-size: 19dp;
	font-weight: normal;
	color: #515253;
}


.ss-cell.best
{
	color: #D1FD04;
}


.surface.ss-challenge
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	padding: 30dp;
	border-left: 4dp #D1FD04;
}

.ss-challenge-portrait
{
	display: block;
	flex: 0 0 auto;
	width: 330dp;
	height: 327dp;
	background-color: #0E0F10;
	border: 1dp #898A8B46;
}

.ss-challenge-portrait mappedimage
{
	display: block;
	width: 330dp;
	height: 327dp;
}

.ss-challenge-text
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-left: 40dp;
}

.ss-challenge-header
{
	display: block;
	margin-top: 10dp;
	font-size: 40dp;
	line-height: 48dp;
	font-weight: bold;
	color: #FFFFFF;
}

.ss-challenge-remarks
{
	display: block;
	margin-top: 16dp;
	font-size: 22dp;
	line-height: 30dp;
	color: #DCDDDE;
}


.col-side.ss-side
{
	width: 540dp;
}

.surface.ss-academy
{
	display: flex;
	flex-direction: column;
	flex: 0 1 auto;
	min-height: 0;
	max-height: 280dp;
	border-left: 4dp #D1FD04;
}

.ss-academy-body
{
	flex: 0 1 auto;
	margin-top: 10dp;
}

.ss-tip
{
	display: block;
	padding: 4dp 0;
	font-size: 19dp;
	line-height: 25dp;
	color: #DCDDDE;
}

.surface.ss-chat
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-height: 0;
	padding: 14dp 16dp 16dp 16dp;
}

.ss-chat-log
{
	flex: 1 1 0%;
	min-height: 0;
	padding-right: 8dp;
}

.ss-chat-line
{
	display: block;
	padding: 2dp 0;
	font-size: 18dp;
	line-height: 23dp;
	color: #DCDDDE;
}

.ss-chat-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 10dp;
}

.ss-chat-entry .chat-input
{
	flex: 1 1 auto;
	margin-right: 10dp;
}


.ss-saved
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 50dp;
	margin-left: 15dp;
	padding: 0 20dp;
	font-size: 18dp;
	font-weight: bold;
	color: #DCDDDE;
	background-color: #0E0F10D9;
}

.ss-saved .dot
{
	margin-right: 10dp;
}


@media (max-aspect-ratio: 3/2)
{
	.col-side.ss-side { width: 320dp; }
	.ss-who { flex: 1.8 1 0%; }
	.ss-row .ss-cell { font-size: 20dp; }
	.ss-cell { padding-left: 4dp; }
	.ss-head .ss-cell { font-size: 13dp; line-height: 16dp; letter-spacing: 0.5dp; }
	.ss-name { font-size: 19dp; }
	.pc-badge.ss-badge { flex-basis: 40dp; width: 40dp; height: 40dp; margin-right: 10dp; line-height: 38dp; }
	.ss-badge mappedimage { width: 32dp; height: 32dp; }
	.ss-hl { padding: 14dp 16dp; }
	.ss-hl .overline { font-size: 14dp; letter-spacing: 0.5dp; white-space: normal; line-height: 17dp; height: 34dp; }
	.ss-hl-value { font-size: 30dp; line-height: 36dp; }
	.ss-hl-name { font-size: 16dp; }
	.ss-fact { padding: 0 14dp; max-width: 300dp; }
	.ss .hq-crumb { display: none; }


	.ss-name-wrap { display: block; }
	.ss-tags { margin-left: 0; margin-top: 2dp; }
	.ss-row.observer { height: 54dp; }
	.has-side .pc-badge.ss-badge { display: none; }
	.has-side .ss-row .ss-cell { font-size: 18dp; }
	.has-side .ss-who { flex: 1.6 1 0%; padding-right: 6dp; }
	.has-side .ss-head .ss-cell { letter-spacing: 0; }
	.has-side .ss-row, .has-side .list-head.ss-head { padding-left: 12dp; padding-right: 10dp; }
}

.ss .screen-body { flex-direction: column; }
.ss .col-main { width: 100%; min-width: 0; }
.ss .col-side.ss-side { flex: 0 1 auto; flex-direction: row; width: 100%; margin-top: 18dp; max-height: 170dp; }
.ss-side .ss-academy, .ss-side .ss-chat { flex: 1 1 0%; min-width: 0; }
.ss-side .ss-chat { margin-left: 18dp; }
.surface.ss-table { padding: 14dp 16dp 16dp; background-color: #17191BF2; border: 1dp #46494C80; border-radius: 0; }
.ss-groups, .list-head.ss-head { display: flex; flex-direction: row; align-items: center; padding-left: 16dp; padding-right: 16dp; border-left: 6dp transparent; box-sizing: border-box; }
.ss-groups { min-height: 46dp; padding-top: 8dp; padding-bottom: 10dp; }
.ss-table .ss-who { flex: 0 0 26%; padding-right: 12dp; box-sizing: border-box; }
.ss-table .ss-cell { flex: 0 0 10.571428%; box-sizing: border-box; padding: 0 10dp; }
.ss-group { flex: 0 0 31.714284%; box-sizing: border-box; text-align: center; font-size: 24dp; line-height: 30dp; font-weight: bold; letter-spacing: 1dp; color: #E0E2E4; }
.ss-group.ss-group-supplies { flex-basis: 10.571428%; }
.ss-divider { border-left: 1dp #46494C80; }
.list-head.ss-head { min-height: 62dp; padding-top: 8dp; padding-bottom: 12dp; border-bottom: 1dp #46494C80; }
.ss-table .ss-head .ss-header-stat { display: flex; align-items: center; justify-content: flex-end; font-size: 20dp; line-height: 28dp; font-weight: normal; text-transform: none; letter-spacing: 0; white-space: nowrap; color: #C2C7CC; }
.ss-head .ss-who { font-size: 20dp; line-height: 28dp; letter-spacing: 1dp; color: #C2C7CC; }
.ss-stat-icon { display: block; flex: 0 0 auto; width: 48dp; height: 32dp; margin-right: 10dp; }
.ss-rows { max-height: 650dp; }
.ss-table .ss-row { height: 76dp; margin-top: 4dp; background-color: #202326D9; padding-left: 16dp; padding-right: 16dp; border-bottom: 1dp #46494C80; }
.ss-row-slot:nth-child(even) .ss-row { background-color: #262A2ED9; }
.ss-rows .ss-row.local { background-color: #343A40EE; }
.ss-row-slot:hover .ss-row { background-color: #3B4249EE; }
.ss-table .ss-row .ss-cell { font-size: 28dp; line-height: 36dp; font-weight: normal; color: #E9EAEC; }
.ss-table .ss-row .ss-cell.best { color: #E0E2E4; font-weight: bold; }
.ss-table .ss-row.observer .ss-cell { color: #C2C7CC; }
.ss-table .ss-name { font-size: 24dp; }
.ss-personal { display: block; margin-bottom: 20dp; }
.ss-personal-title { display: block; font-size: 22dp; line-height: 30dp; letter-spacing: 1dp; color: #C2C7CC; margin-bottom: 10dp; }
.ss-summary-grid { display: flex; flex-direction: row; }
.ss-summary-item { display: block; flex: 1 1 0%; min-width: 0; padding: 22dp 24dp; margin-right: 14dp; background-color: #17191BF2; border: 1dp #46494C80; box-sizing: border-box; }
.ss-summary-item:last-child { margin-right: 0; }
.ss-summary-label { display: flex; align-items: center; font-size: 20dp; line-height: 28dp; color: #C2C7CC; }
.ss-summary-value { display: block; margin-top: 12dp; font-size: 48dp; line-height: 58dp; color: #F2F2F0; font-weight: normal; }
.surface.ss-details { display: flex; flex-direction: row; align-items: center; padding: 16dp 20dp; margin-top: 16dp; background-color: #17191BF2; border: 1dp #46494C80; }
.ss-details-copy { flex: 1 1 0%; min-width: 0; }
.ss-details-title { font-size: 22dp; line-height: 30dp; color: #E9EAEC; }
.ss-match-id, .ss-details-note { margin-top: 6dp; font-size: 18dp; line-height: 26dp; color: #C2C7CC; }
@media (max-aspect-ratio: 3/2)
{
    .ss-table .ss-head .ss-header-stat { font-size: 17dp; }
    .ss-stat-icon { width: 32dp; height: 22dp; margin-right: 6dp; }
    .ss-table .ss-cell { padding-left: 6dp; padding-right: 6dp; }
    .ss-table .ss-row .ss-cell { font-size: 24dp; }
    .ss-summary-item { padding: 16dp; }
    .ss-summary-label { font-size: 17dp; }
    .ss-summary-value { font-size: 40dp; line-height: 48dp; }
}

.ss-table .pc-badge.ss-badge { flex-basis: 52dp; width: 52dp; height: 52dp; line-height: 50dp; }
.ss-table .ss-badge mappedimage { width: 44dp; height: 44dp; }
.ss-table .ss-tags .chip-label { font-size: 14dp; line-height: 20dp; }

.ss-header-stat span { display: block; flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }

.ss-art { left: 50%; margin-left: -50vw; width: 100vw; pointer-events: none; z-index: 0; }
.ss-row { position: relative; }
.ss-player-portrait
{
    display: block;
    position: absolute;
    left: 26%;
    margin-left: -200dp;
    top: 0;
    width: 200dp;
    height: 100%;
    opacity: 0.26;
    pointer-events: none;
    z-index: 0;
}
.ss-row .ss-who, .ss-row .ss-cell { position: relative; z-index: 1; }