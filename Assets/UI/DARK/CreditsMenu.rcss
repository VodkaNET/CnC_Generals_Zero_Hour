

body.cr
{
	background-color: #0E0F10;
}

.cr-art
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	overflow: hidden;
	clip: always;
}

.cr-art-image
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100vw;
	height: 100vh;
}

.cr-scrim
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: #0E0F10A0;
}


.cr-band
{
	display: block;
	position: absolute;
	left: 16.667%;
	width: 66.667%;
	top: 112dp;
	bottom: 88dp;
	background-color: #0E0F10B4;
	border-left: 1dp #898A8B28;
	border-right: 1dp #898A8B28;
}

.cr-lines
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	overflow: hidden;
	pointer-events: none;
}


.cr-frame
{
	pointer-events: none;
}

.cr-frame .action-bar button
{
	pointer-events: auto;
}


.credit-line
{
	position: absolute;
	left: 0;
	width: 100%;
	text-align: center;
	white-space: nowrap;
	font-effect: glow(1dp 4dp 0dp 1dp #000000C8);
}

.credit-line.title
{
	font-weight: bold;
	font-size: 20dp;
	letter-spacing: 1dp;
}

.credit-line.position
{
	font-size: 14dp;
	font-weight: bold;
	letter-spacing: 1dp;
}

.credit-line.normal
{
	font-size: 13dp;
}


.credit-line.column-left
{
	left: 16.667%;
	width: 33.333%;
}

.credit-line.column-right
{
	left: 50%;
	width: 33.333%;
}
