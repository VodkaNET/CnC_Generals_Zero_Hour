


body
{
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 60; 
}


.buddy-toast
{
	display: block;
	position: fixed;
	right: 72dp; 
	bottom: 8dp;
	max-width: 360dp;
	padding: 12dp 18dp 12dp 16dp;
	font-size: 18dp;
	line-height: 24dp;
	font-weight: bold;
	color: #F1F2F3;
	background-color: #0E0F10F2;
	border-left: 4dp #959697;
	pointer-events: auto;
	z-index: 200; 
}

.buddy-toast:hover
{
	background-color: #1B1C1DF2;
	color: #FFFFFF;
}
