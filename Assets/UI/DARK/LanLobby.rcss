


.surface.name-plate
{
	flex: 0 0 auto;
	padding: 16dp 20dp 18dp 20dp;
}

.name-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 10dp;
}

.screen .name-input
{
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 8dp;
}


.side-col
{
	width: 440dp;
}


.games
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-height: 0;
	padding: 10dp 20dp 10dp 20dp;
}

.head-name
{
	flex: 1 1 0%;
	min-width: 0;
}

.head-map
{
	flex: 0 0 300dp;
	margin-left: 15dp;
}

.head-players
{
	flex: 0 0 100dp;
	text-align: right;
}

.game-list
{
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
}

.game-row
{
	height: 50dp;
	color: #DCDDDE;
}

.game-name
{
	flex: 0 1 auto;
	min-width: 0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.game-row.selected .game-name
{
	font-weight: bold;
	color: #FFFFFF;
}

.game-state
{
	flex: 1 1 0%;
	min-width: 0;
	padding-left: 12dp;
}

.game-map
{
	flex: 0 0 300dp;
	margin-left: 15dp;
	color: #B1B2B3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.game-players
{
	flex: 0 0 100dp;
	text-align: right;
	font-weight: bold;
	color: #F1F2F3;
}


.game-row.in-progress .game-name, .game-row.in-progress .game-map, .game-row.in-progress .game-players
{
	color: #707172;
}

.game-row.selected.in-progress .game-name, .game-row.selected.in-progress .game-map, .game-row.selected.in-progress .game-players
{
	color: #B1B2B3;
}


.chat-panel
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	height: 220dp;
}

.chat-col
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-width: 0;
}

.chat-lines
{
	flex: 1 1 0%;
	min-height: 0;
	padding-right: 10dp;
}

.chat-row
{
	display: block;
	padding: 3dp 0;
	line-height: 25dp;
	color: #DCDDDE;
}

.chat-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 13dp;
}

.chat-input
{
	flex: 1 1 auto;
	margin-right: 10dp;
}


.details
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-height: 0;
}

.detail-body
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.detail-top
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
}

.detail-map
{
	width: 170dp;
	height: 170dp;
	margin-right: 18dp;
}

.detail-text
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.detail-name
{
	display: block;
	font-size: 23dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.detail-map-name
{
	display: block;
	margin-top: 2dp;
	color: #B1B2B3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.detail-players-label
{
	display: block;
	margin-top: 16dp;
	letter-spacing: 0;
}

.detail-players
{
	display: block;
	margin-top: 2dp;
	font-size: 21dp;
	font-weight: bold;
	color: #F1F2F3;
}

.detail-chip
{
	display: block;
	margin-top: 12dp;
}


.slots
{
	display: block;
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
	margin-top: 18dp;
	border-top: 1dp #898A8B28;
	padding-top: 10dp;
}

.slot
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 40dp;
	padding-left: 12dp;
	margin-bottom: 4dp;
	border-left: 4dp #7A7B7C;
	background-color: #0E0F10B4;
	color: #DCDDDE;
}

.slot.human
{
	color: #FFFFFF;
	font-weight: bold;
}

.slot.observer
{
	color: #B1B2B3;
}

.slot-icon
{
	display: block;
	flex: 0 0 auto;
	width: 26dp;
	height: 26dp;
	margin-right: 12dp;
}

.slot-icon img
{
	display: block;
}

.slot-label
{
	flex: 1 1 0%;
	min-width: 0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}


.roster
{
	display: flex;
	flex-direction: column;
	flex: 0 0 300dp;
	min-height: 0;
	margin-left: 20dp;
	padding-left: 20dp;
	border-left: 1dp #898A8B28;
}

.roster-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-bottom: 10dp;
}

.roster-count
{
	margin-left: auto;
	font-size: 16dp;
	font-weight: bold;
	color: #B1B2B3;
}

.roster-list
{
	display: block;
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
}

.roster-row
{
	display: block;
	height: 34dp;
	line-height: 34dp;
	color: #DCDDDE;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.roster-row .dot
{
	margin-right: 12dp;
	vertical-align: middle;
}


@media (max-aspect-ratio: 3/2)
{
	.side-col { width: 320dp; }
	.detail-map { width: 110dp; height: 110dp; margin-right: 14dp; }
	.head-map, .game-map { flex-basis: 190dp; }
	.head-players, .game-players { flex-basis: 70dp; }
	.roster { flex-basis: 220dp; }
}
