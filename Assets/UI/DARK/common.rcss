

body
{
	font-family: "Noto Sans";
	font-size: 16dp;
	color: #FFFFFF;
}


.t-title { font-size: 26dp; font-weight: bold; }
.t-section { font-size: 18dp; font-weight: bold; }
.t-body { font-size: 16dp; }
.t-small { font-size: 13dp; }
.t-muted { color: #C0C0C0; }


.frame
{
	background-color: rgba(2, 2, 2, 191);
	border: 2dp #3D3E3F;
	padding: 16dp;
}

.title-bar
{
	font-size: 26dp;
	font-weight: bold;
	color: #FFFFFF;
	text-align: center;
	padding-bottom: 8dp;
	border-bottom: 1dp #3D3E3F;
	margin-bottom: 12dp;
}


.panel-box
{
	border: 1dp #3D3E3F;
	background-color: rgba(2, 2, 2, 140);
	padding: 12dp;
}


.tabs
{
	display: flex;
	flex-direction: row;
	margin-bottom: 12dp;
}

.tab
{
	flex: 1 1 0%;
	box-sizing: border-box;
	height: 34dp;
	line-height: 32dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #C0C0C0;
	background-color: rgba(2, 2, 2, 140);
	border: 1dp #3D3E3F;
	margin-right: 4dp;
}

.tab:last-child
{
	margin-right: 0;
}

.tab:hover
{
	color: #FFFFFF;
	border-color: #898A8B;
}

.tab.selected
{
	color: #FFFFFF;
	background-color: rgba(61, 62, 63, 140);
	border: 1dp #898A8B;
}


.row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 32dp;
	margin-bottom: 8dp;
}

.row > .label
{
	flex: 0 0 40%;
	box-sizing: border-box;
	padding-right: 12dp;
	color: #FFFFFF;
}

.row > .control
{
	flex: 1 1 0%;
	min-width: 0;
}

.row > .control.checkbox
{
	flex: 0 0 auto;
}

.row.disabled > .label,
.row.disabled > .control
{
	color: #C0C0C0;
}


button, .button
{
	display: inline-block;
	box-sizing: border-box;
	decorator: tiled-horizontal(Buttons-Left, Buttons-Middle, Buttons-Right);
	color: #FFFFFF;
	font-effect: shadow(1dp 1dp #000000);
	height: 34dp;
	line-height: 34dp;
	padding: 0 18dp;
	font-size: 16dp;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	white-space: nowrap;
}

.btn-primary, .button-lg
{
	height: 48dp;
	line-height: 48dp;
	padding: 0 32dp;
	min-width: 180dp;
	font-size: 20dp;
}

.btn-inline
{
	height: 32dp;
	line-height: 32dp;
	padding: 0 12dp;
	font-size: 14dp;
}

button:hover, .button:hover
{
	decorator: tiled-horizontal(Buttons-HiLite-Left, Buttons-HiLite-Middle, Buttons-HiLite-Right);
	color: #BAFF0C;
}

button:active, .button:active
{
	decorator: tiled-horizontal(Buttons-Pushed-Left, Buttons-Pushed-Middle, Buttons-Pushed-Right);
	color: #BAFF0C;
}


button.active
{
	decorator: tiled-horizontal(Buttons-HiLite-Left, Buttons-HiLite-Middle, Buttons-HiLite-Right);
	color: #BAFF0C;
}


button:disabled, button[disabled], .button.disabled, button.disabled,
button[disabled]:hover, button.disabled:hover, .button.disabled:hover,
button[disabled]:active, button.disabled:active, .button.disabled:active
{
	decorator: tiled-horizontal(Buttons-Disabled-Left, Buttons-Disabled-Middle, Buttons-Disabled-Right);
	color: #424344;
	font-effect: shadow(1dp 1dp #212223);
}


.icon-btn, .joingame-close,
.icon-btn:hover, .joingame-close:hover,
.icon-btn:active, .joingame-close:active
{
	decorator: none;
	font-effect: none;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #3D3E3F;
}

.icon-btn:hover, .joingame-close:hover
{
	border-color: #898A8B;
	color: #898A8B;
}


.icon-btn.icon-btn
{
	width: 32dp;
	height: 32dp;
	min-width: 0;
	line-height: 30dp;
	padding: 3dp;
	text-align: center;
	overflow: hidden;
}

.icon-btn mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
	overflow: hidden;
}


select
{
	display: inline-block;
	box-sizing: border-box;
	height: 32dp;
	background-color: rgba(2, 2, 2, 220);
	border: 1dp #3D3E3F;
	color: #FFFFFF;
	font-size: 16dp;
	vertical-align: middle;
}

select selectvalue
{
	height: 30dp;
	line-height: 30dp;
	margin-right: 32dp;
	padding: 0 8dp;
	white-space: nowrap;
	overflow: hidden;
}

select selectarrow
{
	width: 30dp;
	height: 30dp;
	decorator: image(VSliderDownButtonEnabled);
}

select:hover, select:focus
{
	border-color: #898A8B;
}

select:hover selectarrow
{
	decorator: image(VSliderDownButtonHilite);
}

select:checked selectarrow
{
	decorator: image(VSliderDownButtonHiliteSelected);
}

select[disabled], select[disabled]:hover
{
	border-color: rgba(61, 62, 63, 110);
	background-color: rgba(2, 2, 2, 120);
	color: #808182;
}

select[disabled] selectarrow, select[disabled]:hover selectarrow
{
	decorator: image(VSliderDownButtonDisabled);
	opacity: 0.6;
}


select selectbox
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	background-color: #0E0F10;
	border: 1dp #898A8B;
	padding: 2dp 0;
	max-height: 320dp;
	overflow-y: auto;
	z-index: 100;
}

select selectbox option
{
	flex: 0 0 auto;
	overflow: hidden;
	text-overflow: ellipsis;
	height: 30dp;
	line-height: 30dp;
	padding: 0 10dp;
	white-space: nowrap;
	color: #FFFFFF;
}

select selectbox option:hover
{
	background-color: rgba(61, 62, 63, 220);
}

select selectbox option:checked
{
	color: #BAFF0C;
}


.color-swatch
{
	display: inline-block;
	width: 14dp;
	height: 14dp;
	margin-right: 8dp;
	border: 1dp rgba(255, 255, 255, 160);
	vertical-align: middle;
}


input.range
{
	height: 20dp;
}

input.range slidertrack
{
	margin-top: 7dp;
	height: 6dp;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #3D3E3F;
}

input.range sliderbar
{
	width: 12dp;
	height: 20dp;
	background-color: #898A8B;
	border: 1dp #3D3E3F;
}

input.range sliderbar:hover
{
	background-color: #BAFF0C;
}

input.range[disabled] sliderbar
{
	background-color: #424344;
}


input.checkbox
{
	width: 20dp;
	height: 20dp;
	decorator: image(Active-Unchecked);
}

input.checkbox:hover
{
	decorator: image(Active-HiLighted);
}

input.checkbox:checked, input.checkbox:checked:hover
{
	decorator: image(Active-Checked);
}

input.checkbox[disabled], input.checkbox[disabled]:hover
{
	decorator: image(Disabled-Unchecked);
}

input.checkbox[disabled]:checked
{
	decorator: image(Disabled-Checked);
}



.scroll-container
{
	overflow-y: auto;
	flex: 1 1 auto;
	min-height: 0;
}


scrollbarvertical
{
	width: 12dp;
}

scrollbarvertical slidertrack
{
	width: 12dp;
	background-color: rgba(2, 2, 2, 191);
	border-left: 1dp rgba(61, 62, 63, 110);
	border-right: 1dp rgba(61, 62, 63, 60);
}


scrollbarvertical sliderbar
{
	box-sizing: border-box;
	width: 12dp;
	min-height: 32dp;
	border-top: 1dp #898A8B;
	border-left: 1dp #5C5D5E;
	border-bottom: 1dp #111213;
	border-right: 1dp #28292A;
	decorator: horizontal-gradient(#4D4E4F #393A3B);
}

scrollbarvertical sliderbar:hover
{
	border-top-color: #C7C8C9;
	decorator: horizontal-gradient(#676869 #4D4E4F);
}

scrollbarvertical sliderbar:active
{
	border-top-color: #FFFFFF;
	decorator: horizontal-gradient(#898A8B #676869);
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc
{
	width: 0dp;
	height: 0dp;
}


.text-input, .chat-input
{
	box-sizing: border-box;
	height: 32dp;
	line-height: 30dp;
	background-color: rgba(2, 2, 2, 220);
	border: 1dp #3D3E3F;
	color: #FFFFFF;
	padding: 0 8dp;
}

.text-input:hover, .chat-input:hover
{
	border-color: #666768;
}

.text-input[disabled]
{
	color: #808182;
	border-color: rgba(61, 62, 63, 110);
}

.text-input:focus, .chat-input:focus
{
	border-color: #898A8B;
}



.spacer
{
	flex: 1 1 auto;
}


.section-title
{
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
	padding-bottom: 4dp;
	border-bottom: 1dp #3D3E3F;
	margin-bottom: 8dp;
	flex: 0 0 auto;
}


scrolllog
{
	display: block;
	overflow-y: auto;
}


.list-box, .text-list, .chat-log
{
	border: 1dp #3D3E3F;
	background-color: rgba(2, 2, 2, 140);
}

.list-box.opaque
{
	background-color: rgba(2, 2, 2, 191);
}

.text-list, .chat-log
{
	padding: 4dp 6dp;
}


.list-box > div, .text-list > div
{
	display: block;
}


.text-line
{
	display: block;
	padding: 1dp 0;
}


.list-row
{
	display: block;
	box-sizing: border-box;
	min-height: 30dp;
	padding: 5dp 8dp;
	border-bottom: 1dp rgba(61, 62, 63, 80);
}

.list-row.flex
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.list-row.compact
{
	min-height: 26dp;
	padding: 2dp 8dp;
}

.list-row:hover
{
	background-color: rgba(61, 62, 63, 60);
}

.list-row.selected
{
	background-color: rgba(61, 62, 63, 120);
	border: 1dp #898A8B;
}


.chat
{
	display: flex;
	flex-direction: column;
	margin-top: 12dp;
	height: 160dp;
}

.chat-log
{
	flex: 1 1 0%;
	min-height: 0;
	background-color: rgba(2, 2, 2, 191);
}

.chat-line
{
	display: block;
}

.chat-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 8dp;
}

.chat-input
{
	flex: 1 1 auto;
	margin-right: 8dp;
}


.rank-column
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 128dp;
	margin-right: 12dp;
}

.rank-border
{
	position: relative;
	box-sizing: border-box; 
	width: 128dp;
	height: 156dp;
	background-color: #0E0F10;
	border: 1dp #3D3E3F;
}

.rank-image-wrap
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 100%; 
	height: 128dp;
	border-bottom: 1dp #3D3E3F;
}

.rank-image
{
	display: block;
	width: 100%;
	height: 128dp;
}

.faction-image
{
	display: block;
	position: absolute;
	right: 0dp;
	bottom: 0dp;
	width: 48dp;
	height: 48dp;
}


.rank-progress
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	left: 0;
	bottom: 0;
	width: 100%; 
	height: 24dp;
	padding: 3dp;
	background-color: #0E0F10E6;
	border: 1dp #4D4E4F;
	border-top-color: #28292A;
}

.rank-progress-fill
{
	display: block;
	box-sizing: border-box;
	height: 100%;
	background-color: #D1FD04;
	decorator: vertical-gradient(#E6FF6A #8FB000);
	border-right: 2dp #F4FFC0;
}

.rank-label
{
	margin-top: 4dp;
	text-align: center;
	flex: 0 0 auto;
}


.footer
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	flex: 0 0 auto;
	margin-top: 12dp;
	border-top: 1dp #3D3E3F;
	padding-top: 12dp;
}

.footer button
{
	margin-left: 12dp;
}


.footer-split
{
	justify-content: space-between;
}

.footer-split button
{
	margin-left: 0;
}


.shell-background
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -1;
}

body.shell
{
	width: 100%;
	height: 100%;
}

.shell-frame
{
	box-sizing: border-box;
	position: absolute;
	left: 5.6%;
	top: 7.3%;
	width: 88.8%;
	height: 85.4%;
	background-color: rgba(2, 2, 2, 190);
	border: 2dp #3D3E3F;
	padding: 16dp;
	display: flex;
	flex-direction: column;
}

.shell-title-bar
{
	font-size: 26dp;
	font-weight: bold;
	color: #FFFFFF;
	text-align: left;
	padding-bottom: 8dp;
	border-bottom: 1dp #3D3E3F;
	margin-bottom: 12dp;
	flex: 0 0 auto;
}


.context-menu-backdrop
{
	display: block;
	position: fixed;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: 100;
}

.context-menu
{
	display: block;
	position: fixed;
	z-index: 101;
	background-color: rgba(2, 2, 2, 235);
	border: 1dp #3D3E3F;
	min-width: 110dp;
}

.context-menu-item
{
	display: block;
	height: 30dp;
	line-height: 30dp;
	padding: 0 12dp;
	color: #FFFFFF;
	text-align: center;
	border-bottom: 1dp rgba(61, 62, 63, 80);
}

.context-menu-item:last-child
{
	border-bottom: 0dp transparent;
}

.context-menu-item:hover
{
	background-color: rgba(61, 62, 63, 160);
}




body.screen
{
	width: 100%;
	height: 100%;
	font-size: 20dp;
}


.screen-ruler
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: 3;
	pointer-events: none;
}

.screen-ruler .rs, .screen-ruler .rc
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	pointer-events: none;
	border-color: #9C9D9EB8;
}

.screen-ruler .rs > div, .screen-ruler .rc > div
{
	display: none;
}


.hq .screen-ruler, .mm-d .screen-ruler
{
	border-width: 112dp 40dp 88dp 40dp;
	border-color: #0E0F10A8;
}


.hq .screen-ruler .rs-top, .mm-d .screen-ruler .rs-top
{
	left: 0;
	right: 0;
	top: -16dp;
	height: 16dp;
	border-bottom-width: 1dp;
	decorator: ruler-ticks(bottom #9C9D9EA0 none);
}

.hq .screen-ruler .rs-bottom, .mm-d .screen-ruler .rs-bottom
{
	left: 0;
	right: 0;
	bottom: -16dp;
	height: 16dp;
	border-top-width: 1dp;
	decorator: ruler-ticks(top #9C9D9EA0 none);
}

.hq .screen-ruler .rs-left, .mm-d .screen-ruler .rs-left
{
	left: -16dp;
	top: 0;
	bottom: 0;
	width: 16dp;
	border-right-width: 1dp;
	decorator: ruler-ticks(right #9C9D9EA0 none);
}

.hq .screen-ruler .rs-right, .mm-d .screen-ruler .rs-right
{
	right: -16dp;
	top: 0;
	bottom: 0;
	width: 16dp;
	border-left-width: 1dp;
	decorator: ruler-ticks(left #9C9D9EA0 none);
}


.hq .screen-ruler .rc, .mm-d .screen-ruler .rc
{
	width: 16dp;
	height: 16dp;
	border-width: 1dp;
	background-color: #9C9D9E30;
}

.hq .screen-ruler .rc > div, .mm-d .screen-ruler .rc > div
{
	display: block;
	position: absolute;
	left: 4dp;
	top: 4dp;
	width: 6dp;
	height: 6dp;
	background-color: #9C9D9EC0;
}

.hq .rc-tl, .mm-d .rc-tl { left: -16dp; top: -16dp; }
.hq .rc-tr, .mm-d .rc-tr { right: -16dp; top: -16dp; }
.hq .rc-bl, .mm-d .rc-bl { left: -16dp; bottom: -16dp; }
.hq .rc-br, .mm-d .rc-br { right: -16dp; bottom: -16dp; }


.ld .screen-ruler .rs-top, .mm-a .screen-ruler .rs-top, .mm-b .screen-ruler .rs-top, .mm-c .screen-ruler .rs-top
{
	left: 0;
	right: 0;
	top: 0;
	height: 20dp;
	border-bottom-width: 2dp;
	decorator: ruler-ticks(top #9C9D9EB8);
}

.ld .screen-ruler .rs-bottom, .mm-a .screen-ruler .rs-bottom, .mm-b .screen-ruler .rs-bottom, .mm-c .screen-ruler .rs-bottom
{
	left: 0;
	right: 0;
	bottom: 0;
	height: 20dp;
	border-top-width: 2dp;
	decorator: ruler-ticks(bottom #9C9D9EB8);
}

.ld .screen-ruler .rs-left, .mm-a .screen-ruler .rs-left, .mm-b .screen-ruler .rs-left, .mm-c .screen-ruler .rs-left
{
	left: 0;
	top: 20dp;
	bottom: 20dp;
	width: 20dp;
	border-right-width: 2dp;
	decorator: ruler-ticks(left #9C9D9EB8);
}

.ld .screen-ruler .rs-right, .mm-a .screen-ruler .rs-right, .mm-b .screen-ruler .rs-right, .mm-c .screen-ruler .rs-right
{
	right: 0;
	top: 20dp;
	bottom: 20dp;
	width: 20dp;
	border-left-width: 2dp;
	decorator: ruler-ticks(right #9C9D9EB8);
}


.screen-frame
{
	box-sizing: border-box;
	position: absolute;
	left: 88dp;
	right: 88dp;
	top: 78dp;
	bottom: 78dp;
	max-width: 2150dp;
	margin-left: auto;
	margin-right: auto;
	display: flex;
	flex-direction: column;
}

.hq .screen-frame, .mm-d .screen-frame
{
	left: 60dp;
	right: 60dp;
	top: 132dp;
	bottom: 108dp;
	max-width: none;
}


.map-glow, .screen-crumb, .screen-title, .screen .btn-back, .on-map, .hq-crumb, .hq-title, .hq-clock
{
	font-effect: glow(1dp 8dp 0dp 1dp #000000F0);
}


.screen-header
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	padding: 10dp 0 0 0;
	margin-bottom: 23dp;
}


.screen-heading
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 1 auto;
	min-width: 0;
	padding: 8dp 28dp 8dp 20dp;
	background-color: #0E0F10D9;
}

.screen-crumb
{
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #C0C1C2;
	margin-right: 18dp;
	white-space: nowrap;
}

.crumb-sep
{
	color: #898A8B;
	margin: 0 8dp;
}

.screen-title
{
	font-size: 40dp;
	line-height: 50dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #FFFFFF;
	border-left: 4dp #D1FD04;
	padding-left: 15dp;
	white-space: nowrap;
}

.screen-header-aside
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-left: auto;
}


.screen-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 0%;
	min-height: 0;
}

.col
{
	display: flex;
	flex-direction: column;
	min-width: 0;
	min-height: 0;
}

.col-main
{
	flex: 1 1 0%;
}

.col-side
{
	flex: 0 0 auto;
	margin-left: 20dp;
}


.surface
{
	display: block;
	background-color: #0E0F10E0;
	padding: 20dp;
}

.surface + .surface
{
	margin-top: 20dp;
}


.overline
{
	display: block;
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #8A8B8C;
	white-space: nowrap;
}

.muted { color: #B1B2B3; }
.dim { color: #7A7B7C; }


.action-bar
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 75dp;
	margin-top: 20dp;
}

.hq .screen-frame > .action-bar
{
	position: absolute;
	left: 0;
	right: 0;
	bottom: -100dp;
	height: 58dp;
	margin-top: 0;
	z-index: 4;
}

.hq.dock-open .screen-frame > .action-bar
{
	right: -390dp;
}

.screen.hq .action-bar button
{
	height: 48dp;
	line-height: 46dp;
}

.screen.hq .action-bar button.btn-cta
{
	height: 58dp;
	line-height: 54dp;
}

.action-bar button
{
	margin-left: 15dp;
}

.action-bar button:first-child
{
	margin-left: 0;
}


.screen button, .screen .button
{
	decorator: none;
	font-effect: none;
	box-sizing: border-box;
	height: 50dp;
	line-height: 48dp;
	padding: 0 25dp;
	min-width: 0;
	font-size: 19dp;
	font-weight: bold;
	letter-spacing: 1dp;
	color: #DCDDDE;
	background-color: #1B1C1DD7;
	border: 1dp #898A8B46;
	transition: background-color color border-color 0.12s cubic-out;
}

.screen button:hover, .screen .button:hover
{
	decorator: none;
	color: #D1FD04;
	background-color: #3D3E3FD2;
	border-color: #898A8B;
}

.screen button:active, .screen .button:active
{
	decorator: none;
	color: #D1FD04;
	background-color: #28292AE6;
	border-color: #898A8B;
}

.screen button:focus-visible
{
	border-color: #D1FD04;
}

.screen button[disabled], .screen button.disabled,
.screen button[disabled]:hover, .screen button.disabled:hover,
.screen button[disabled]:active, .screen button.disabled:active
{
	decorator: none;
	font-effect: none;
	color: #515253;
	background-color: #101112AA;
	border-color: #898A8B1E;
}


.screen button.btn-cta
{
	height: 65dp;
	line-height: 61dp;
	min-width: 300dp;
	padding: 0 50dp;
	font-size: 24dp;
	letter-spacing: 2dp;
	color: #FFFFFF;
	border: 2dp #777879;
	decorator: vertical-gradient(#535455 #343536);
}

.screen button.btn-cta:hover, .screen button.btn-cta:focus-visible
{
	color: #D1FD04;
	border-color: #D1FD04;
	decorator: vertical-gradient(#606162 #3D3E3F);
}

.screen button.btn-cta:active
{
	color: #D1FD04;
	border-color: #A8CC00;
	decorator: vertical-gradient(#28292A #373839);
}

.screen button.btn-cta[disabled], .screen button.btn-cta[disabled]:hover, .screen button.btn-cta[disabled]:active
{
	decorator: none;
	color: #515253;
	background-color: #212223C8;
	border-color: #898A8B1E;
}


.screen button.btn-back
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 50dp;
	line-height: 25dp;
	padding: 0 23dp 0 15dp;
	font-size: 21dp;
	color: #CBCCCD;
	background-color: #0E0F10C8;
	border-color: transparent;
}

.screen button.btn-back:hover
{
	color: #FFFFFF;
	background-color: #28292AE6;
	border-color: transparent;
}

.screen button.btn-back:active
{
	color: #D1FD04;
}

.screen button.btn-back[disabled], .screen button.btn-back[disabled]:hover, .screen button.btn-back[disabled]:active
{
	color: #515253;
	background-color: #0E0F108C;
	border-color: transparent;
}

.btn-back[disabled] .chevron
{
	color: #515253;
}

.chevron
{
	font-size: 33dp;
	margin-right: 10dp;
	color: #898A8B;
}


.btn-back .chevron
{
	flex: 0 0 auto;
	line-height: 33dp;
	margin-top: -5dp;
}

.screen button.btn-small
{
	height: 40dp;
	line-height: 38dp;
	padding: 0 18dp;
	font-size: 16dp;
}


.seg
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	background-color: #0E0F10C8;
	border: 1dp #898A8B28;
	padding: 2dp;
}

.screen .seg button.seg-item
{
	height: 38dp;
	line-height: 38dp;
	padding: 0 15dp;
	min-width: 38dp;
	font-size: 18dp;
	letter-spacing: 0.5dp;
	text-align: center;
	color: #B1B2B3;
	background-color: transparent;
	border-width: 0;
	margin-left: 2dp;
}

.screen .seg button.seg-item:first-child
{
	margin-left: 0;
}

.screen .seg button.seg-item:hover
{
	color: #FFFFFF;
	background-color: #3D3E3F78;
}

.screen .seg button.seg-item.on, .screen .seg button.seg-item.on:hover
{
	color: #FFFFFF;
	background-color: #4D4E4F;
}

.screen .seg button.seg-item[disabled], .screen .seg button.seg-item[disabled]:hover
{
	color: #515253;
	background-color: transparent;
}

.screen .seg button.seg-item.on[disabled]
{
	color: #B1B2B3;
	background-color: #3D3E3F50;
}

.screen select.seg-overflow
{
	display: block;
	width: 100%;
	margin-bottom: 14dp;
}

.screen select.seg-overflow selectbox
{
	max-height: 250dp;
}


.swatches
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.screen .swatches button.swatch
{
	box-sizing: border-box;
	flex: 0 0 auto;
	width: 28dp;
	height: 28dp;
	padding: 2dp;
	margin-right: 2dp;
	background-color: transparent;
	border: 2dp transparent;
	transition: border-color 0.12s cubic-out;
}

.swatch .chip
{
	display: block;
	width: 100%;
	height: 100%;
	line-height: 20dp;
	font-size: 15dp;
	font-weight: bold;
	text-align: center;
	color: #B1B2B3;
	transition: opacity 0.12s cubic-out;
}

.swatch.random .chip
{
	box-sizing: border-box;
	line-height: 18dp;
	border: 1dp #898A8B6E;
}

.screen .swatches button.swatch:hover
{
	background-color: transparent;
	border-color: #FFFFFF78;
}

.swatch.random:hover .chip
{
	color: #FFFFFF;
}

.screen .swatches button.swatch.on, .screen .swatches button.swatch.on:hover
{
	background-color: transparent;
	border-color: #FFFFFF;
}

.swatch.random.on .chip
{
	color: #FFFFFF;
	border-color: #FFFFFF;
}


.screen .swatches button.swatch[disabled], .screen .swatches button.swatch[disabled]:hover
{
	background-color: transparent;
	border-color: transparent;
}

.swatch[disabled] .chip
{
	opacity: 0.45;
}

.screen .swatches button.swatch.on[disabled]
{
	border-color: #B1B2B3;
}

.swatch.on[disabled] .chip
{
	opacity: 1;
}


.swatch.taken .chip, .swatch.taken[disabled] .chip
{
	opacity: 0.16;
}


label.check
{
	display: flex;
	flex-direction: row;
	align-items: center;
	color: #DCDDDE;
}

label.check:hover
{
	color: #FFFFFF;
}

.screen input.checkbox, .screen input.checkbox:hover
{
	decorator: none;
	box-sizing: border-box;
	width: 25dp;
	height: 25dp;
	margin-right: 13dp;
	background-color: #0E0F10DC;
	border: 2dp #898A8B6E;
	transition: background-color border-color 0.12s cubic-out;
}

.screen label.check:hover input.checkbox
{
	border-color: #898A8B;
}

.screen input.checkbox:checked, .screen input.checkbox:checked:hover
{
	decorator: none;
	background-color: #D1FD04;
	border: 6dp #111213;
}

.screen input.checkbox[disabled], .screen input.checkbox[disabled]:checked
{
	decorator: none;
	opacity: 0.4;
}


.screen input.range
{
	height: 30dp;
}

.screen input.range slidertrack
{
	margin-top: 13dp;
	height: 4dp;
	background-color: #898A8B3C;
	border-width: 0;
}

.screen input.range sliderbar
{
	width: 18dp;
	height: 30dp;
	background-color: #DCDDDE;
	border-width: 0;
	transition: background-color 0.12s cubic-out;
}

.screen input.range sliderbar:hover, .screen input.range sliderbar:active
{
	background-color: #D1FD04;
}


.screen select
{
	height: 45dp;
	background-color: #0E0F10D2;
	border: 1dp #898A8B3C;
	color: #F1F2F3;
	font-size: 19dp;
	transition: background-color border-color 0.12s cubic-out;
}

.screen select selectvalue
{
	height: 43dp;
	line-height: 43dp;
	margin-right: 35dp;
	padding: 0 13dp;
	text-overflow: ellipsis;
}


.screen select selectarrow, .screen select:hover selectarrow, .screen select:checked selectarrow
{
	decorator: none;
	width: 0;
	height: 0;
	margin: 19dp 15dp 0 0;
	border-top: 8dp #898A8B;
	border-left: 6dp transparent;
	border-right: 6dp transparent;
}

.screen select:hover, .screen select:focus
{
	background-color: #1B1C1DE6;
	border-color: #898A8B;
}

.screen select:hover selectarrow, .screen select:checked selectarrow
{
	border-top-color: #FFFFFF;
}

.screen select[disabled], .screen select[disabled]:hover
{
	opacity: 0.45;
	background-color: #0E0F10A0;
	border-color: #898A8B28;
	color: #B1B2B3;
}

.screen select[disabled] selectarrow
{
	decorator: none;
	opacity: 1;
	border-top-color: #7A7B7C;
}

.screen select selectbox
{
	background-color: #0E0F10;
	border: 1dp #4D4E4F;
	padding: 4dp 0;
	max-height: 450dp;
}

.screen select selectbox option
{
	height: 40dp;
	line-height: 40dp;
	padding: 0 15dp;
	color: #DCDDDE;
}

.screen select selectbox option:hover
{
	background-color: #3D3E3FDC;
	color: #FFFFFF;
}

.screen select selectbox option:checked
{
	color: #D1FD04;
}


.screen select selectbox option.occ-player
{
	height: 0;
	line-height: 0;
	padding: 0;
	overflow: hidden;
	visibility: hidden;
}


.screen .text-input, .screen .chat-input
{
	height: 50dp;
	line-height: 48dp;
	padding: 0 15dp;
	background-color: #0E0F10D2;
	border: 1dp #898A8B3C;
	transition: border-color 0.12s cubic-out;
}

.screen .text-input:hover, .screen .chat-input:hover
{
	border-color: #898A8B8C;
}

.screen .text-input:focus, .screen .chat-input:focus
{
	border-color: #898A8B;
	background-color: #111213E6;
}


.screen .send-row .chat-input
{
	margin-right: 0;
	border-right-width: 0;
}

.screen .send-row button.chat-send
{
	display: flex;
	flex: 0 0 auto;
	align-items: center;
	justify-content: center;
	align-self: stretch;
	width: 52dp;
	height: auto;
	min-width: 0;
	padding: 0;
	margin-left: 0;
	line-height: 1;
	background-color: #111213E6;
	border: 1dp #898A8B3C;
}

.screen .send-row button.chat-send:hover
{
	background-color: #3D3E3FD2;
	border-color: #D1FD04;
}

.screen .send-row button.chat-send:active
{
	background-color: #28292AE6;
	border-color: #D1FD04;
}

.chat-send .send-arrow
{
	display: block;
	width: 0;
	height: 0;
	margin-left: 4dp;
	border-left: 16dp #D1FD04;
	border-top: 10dp transparent;
	border-bottom: 10dp transparent;
}

.chat-send:hover .send-arrow
{
	border-left-color: #D1FD04;
}

.chat-send .send-emote
{
	display: block;
	margin-top: 16dp;
	font-size: 44dp;
	line-height: 44dp;
	font-weight: bold;
	color: #D1FD04;
}

.chat-send:hover .send-emote
{
	color: #D1FD04;
}



.screen scrollbarvertical
{
	width: 12dp;
	margin-left: 4dp;
}

.screen scrollbarvertical slidertrack
{
	width: 12dp;
	background-color: #0E0F10B4;
	border-left: 1dp #898A8B1F;
	border-right: 1dp #898A8B1F;
}

.screen scrollbarvertical sliderbar
{
	box-sizing: border-box;
	width: 12dp;
	min-height: 48dp;
	border-top: 1dp #ADAEAF;
	border-bottom: 1dp #1B1C1D;
	border-left: 1dp #676869;
	border-right: 1dp #28292A;
	decorator: horizontal-gradient(#4D4E4F #393A3B);
	transition: border-color 0.12s cubic-out;
}

.screen scrollbarvertical sliderbar:hover
{
	border-top-color: #D6D7D8;
	decorator: horizontal-gradient(#676869 #4D4E4F);
}

.screen scrollbarvertical sliderbar:active
{
	border-top-color: #E6FF6A;
	border-left-color: #C8F000;
	border-right-color: #8FB000;
	border-bottom-color: #4A5C00;
	decorator: horizontal-gradient(#D1FD04 #A8CC00);
}


.row-item
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 44dp;
	padding: 0 15dp 0 13dp;
	border-left: 3dp transparent;
	border-bottom: 1dp #FFFFFF0A;
	transition: background-color 0.1s cubic-out;
}

.row-item:hover
{
	background-color: #3D3E3F4B;
}

.row-item.selected, .row-item.selected:hover
{
	background-color: #3D3E3FA0;
	border-left-color: #D1FD04;
}


.list-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 38dp;
	padding: 0 15dp 0 16dp;
	border-bottom: 1dp #898A8B28;
}


.empty-state
{
	display: block;
	padding: 60dp 30dp;
	text-align: center;
	color: #7A7B7C;
	font-size: 20dp;
}

.empty-state .overline
{
	display: block;
	margin-bottom: 10dp;
}

@keyframes pulse
{
	from { opacity: 0.35; }
	to { opacity: 1; }
}

.pulse
{
	animation: 1.2s cubic-in-out infinite alternate pulse;
}



.stat
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-width: 0;
}

.stat-value
{
	font-size: 33dp;
	line-height: 38dp;
	font-weight: bold;
	color: #F1F2F3;
}

.stat-label
{
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #7A7B7C;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}


.dot
{
	display: inline-block;
	width: 10dp;
	height: 10dp;
	border-radius: 4dp;
	background-color: #36D8B2;
}


.group-title
{
	margin-bottom: 15dp;
}

.map-frame
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 400dp;
	height: 400dp;
	background-color: #0E0F10;
}

.map-image
{
	display: block;
	width: 100%;
	height: 100%;
}


mappreview
{
	position: relative;
}

mappreview .mp-art
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.map-missing
{
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
	color: #7A7B7C;
	text-align: center;
}


.map-card .map-missing
{
	height: 160dp;
}

.map-name
{
	display: block;
	margin: 18dp 0 18dp 0;
	font-size: 25dp;
	font-weight: bold;
	color: #F1F2F3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.map-button
{
	display: block;
}


.marker
{
	display: block;
	position: absolute;
	width: 30dp;
	height: 30dp;
	margin-left: -15dp;
	margin-top: -15dp;
}

.marker-dot
{
	display: block;
	box-sizing: border-box;
	width: 30dp;
	height: 30dp;
	line-height: 25dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #FFFFFF;
	font-effect: shadow(1dp 1dp #000000);
	border: 2dp #FFFFFFB4;
	background-color: #0E0F10A0;
	transition: border-color 0.12s cubic-out;
}

.marker:hover .marker-dot
{
	border-color: #D1FD04;
}

.marker.occupied .marker-dot
{
	border-color: #FFFFFF;
}


.marker:hover
{
	z-index: 5;
}

.marker-label
{
	display: none;
	position: absolute;
	top: 34dp;
	left: -115dp;
	width: 260dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
}

.marker:hover .marker-label
{
	display: block;
}

.marker-label span
{
	display: inline-block;
	padding: 2dp 8dp;
	background-color: #0E0F10E6;
}

.map-meta
{
	display: block;
	margin-top: -10dp;
	color: #B1B2B3;
}





.pc-grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: flex-start;
	align-content: flex-start;
	justify-content: space-between;
}

.player-card
{
	display: block;
	box-sizing: border-box;
	width: 49.3%;
	margin-bottom: 12dp;
	padding: 12dp 14dp;
	background-color: #0E0F10E6;
	border-left: 6dp #7A7B7C;
	border-top: 1dp #898A8B1E;
}

.player-card.human
{
	background-color: #111213EB;
	border-top-color: #898A8B46;
}

.pc-top, .pc-line
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.pc-line
{
	margin-top: 8dp;
}


.pc-badge
{
	display: block;
	flex: 0 0 56dp;
	box-sizing: border-box;
	width: 56dp;
	height: 56dp;
	margin-right: 14dp;
	background-color: #0E0F10DC;
	border: 1dp #898A8B28;
	text-align: center;
	line-height: 54dp;
	font-size: 28dp;
	font-weight: bold;
	color: #7A7B7C;
}

.pc-badge mappedimage
{
	display: block;
	width: 46dp;
	height: 46dp;
	margin: 4dp;
}

.pc-who
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.pc-who select
{
	width: 100%;
	max-width: 270dp;
}

.pc-name
{
	display: block;
	font-size: 24dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.pc-sub
{
	display: block;
	margin-top: 2dp;
	font-size: 16dp;
	color: #B1B2B3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}


.pc-spot
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 30dp;
	margin-left: 12dp;
	padding: 0 10dp 0 8dp;
	background-color: #0E0F10C8;
	border-left: 3dp #B1B2B3;
	white-space: nowrap;
}

.pc-spot-cap
{
	margin-right: 7dp;
	font-size: 13dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #8A8B8C;
}

.pc-spot-no
{
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
}

.pc-spot.random .pc-spot-no
{
	color: #7A7B7C;
}

.pc-line select
{
	flex: 1 1 0%;
	min-width: 0;
}

.pc-line .seg
{
	margin-left: 10dp;
}


.army-icon
{
	display: inline-block;
	width: 30dp;
	height: 30dp;
	margin-right: 12dp;
	vertical-align: middle;
}

.army-random
{
	box-sizing: border-box;
	line-height: 28dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #B1B2B3;
	border: 1dp #898A8B46;
	background-color: #1B1C1D;
}

.army-select selectbox
{
	min-width: 340dp;
}


.army-select selectvalue
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.army-select selectvalue .army-icon
{
	flex: 0 0 auto;
}

.army-name
{
	white-space: nowrap;
}

.army-select selectvalue .army-name
{
	flex: 1 1 auto;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
}


.army-ro
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 0%;
	min-width: 0;
	box-sizing: border-box;
	height: 45dp;
	padding: 0 13dp;
	background-color: #0E0F108C;
	border: 1dp #898A8B1E;
	color: #DCDDDE;
	font-size: 19dp;
}

.army-ro > div
{
	flex: 0 0 auto;
}

.army-ro-label
{
	flex: 1 1 auto;
	min-width: 0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}


.screen .team-seg button.seg-item
{
	flex: 0 0 38dp;
	width: 38dp;
	min-width: 0;
	padding: 0;
}

.screen .team-seg button.seg-item:first-child
{
	flex-basis: 64dp;
	width: 64dp;
}


.player-card.pc-compact
{
	padding-top: 9dp;
	padding-bottom: 9dp;
	background-color: #0E0F10B4;
	border-left-color: #898A8B28;
	border-top-color: transparent;
}

.pc-compact .pc-who
{
	flex: 0 0 160dp;
}

.pc-slot-no
{
	display: block;
	flex: 0 0 auto;
	width: 30dp;
	margin-right: 6dp;
	font-size: 18dp;
	font-weight: bold;
	color: #7A7B7C;
}

.pc-add
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	justify-content: flex-end;
}

.screen .pc-add button
{
	height: 40dp;
	line-height: 38dp;
	padding: 0 12dp;
	margin-left: 6dp;
	font-size: 15dp;
	color: #B1B2B3;
	background-color: transparent;
	border: 1dp #898A8B3C;
}

.screen .pc-add button:hover
{
	color: #FFFFFF;
	border-color: #D1FD04;
	background-color: #3D3E3F78;
}

.screen .pc-add button[disabled], .screen .pc-add button[disabled]:hover, .screen .pc-add button[disabled]:active
{
	color: #515253;
	background-color: transparent;
	border-color: #898A8B1E;
}

.pc-add button[disabled] .pc-plus
{
	color: #515253;
}

.pc-add-label
{
	align-self: center;
	margin-right: 6dp;
	font-size: 13dp;
	color: #7A7B7C;
}

.pc-plus
{
	color: #D1FD04;
	margin-right: 4dp;
}


.stat-card
{
	display: block;
}

.stat-row
{
	display: flex;
	flex-direction: row;
	margin-top: 10dp;
}

.stat-row .stat + .stat
{
	margin-left: 16dp;
	padding-left: 16dp;
	border-left: 1dp #898A8B28;
}


.screen button.tile
{
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	box-sizing: border-box;
	height: auto;
	padding: 24dp 26dp;
	text-align: left;
	letter-spacing: 0;
	background-color: #0E0F10E6;
	border: 1dp #898A8B28;
	border-bottom: 4dp #3D3E3F;
	transition: background-color border-color 0.12s cubic-out;
}

.screen button.tile:hover
{
	background-color: #1B1C1DF0;
	border-color: #898A8B;
	border-bottom-color: #D1FD04;
}

.screen button.tile:active
{
	background-color: #28292AF0;
}

.tile-title
{
	display: block;
	font-size: 36dp;
	line-height: 42dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #FFFFFF;
	white-space: nowrap;
}

.tile-caption
{
	display: block;
	margin-top: 6dp;
	font-size: 18dp;
	line-height: 24dp;
	font-weight: normal;
	letter-spacing: 0;
	text-transform: none;
	color: #B1B2B3;
	white-space: normal;
}

.tile:hover .tile-title
{
	color: #D1FD04;
}


.tab-rail
{
	display: flex;
	flex-direction: column;
	flex: 0 0 300dp;
	padding: 10dp 0;
	background-color: #0E0F10E6;
}

.screen .tab-rail button.rail-item
{
	display: block;
	width: 100%;
	height: 62dp;
	line-height: 62dp;
	padding: 0 24dp 0 22dp;
	text-align: left;
	font-size: 22dp;
	letter-spacing: 2dp;
	color: #B1B2B3;
	background-color: transparent;
	border-width: 0;
	border-left: 4dp transparent;
}

.screen .tab-rail button.rail-item:hover
{
	color: #FFFFFF;
	decorator: horizontal-gradient(#3D3E3FB4 #3D3E3F00);
}

.screen .tab-rail button.rail-item.on, .screen .tab-rail button.rail-item.on:hover
{
	color: #FFFFFF;
	border-left-color: #D1FD04;
	decorator: horizontal-gradient(#3D3E3FF0 #3D3E3F40);
}


.rail-item .hq-scan
{
	left: 22dp;
	bottom: 10dp;
}


.progress
{
	display: block;
	box-sizing: border-box;
	height: 18dp;
	padding: 3dp;
	background-color: #0E0F10E6;
	border: 1dp #4D4E4F;
	border-top-color: #28292A;
}

.progress-fill
{
	display: block;
	box-sizing: border-box;
	height: 100%;
	decorator: vertical-gradient(#E6FF6A #8FB000);
	border-right: 2dp #F4FFC0;
}


.chip-label
{
	display: inline-block;
	padding: 2dp 10dp;
	font-size: 14dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #DCDDDE;
	background-color: #3D3E3F78;
	flex: 0 0 auto;
	white-space: nowrap;
}

.chip-label.good { color: #041410; background-color: #36D8B2; }
.chip-label.accent { color: #0E1400; background-color: #D1FD04; }
.chip-label.warn { color: #1A1604; background-color: #E8D440; }


.chip-status
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 34dp;
	padding: 0 14dp 0 12dp;
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #8A8B8C;
	background-color: #0E0F10C8;
	border: 1dp #898A8B28;
}

.chip-status gametext
{
	text-decoration: line-through;
}

.chip-status .chip-dot
{
	display: block;
	box-sizing: border-box;
	width: 12dp;
	height: 12dp;
	margin-right: 9dp;
	border-radius: 6dp;
	border: 2dp #7A7B7C;
}

.chip-status.on
{
	color: #E4F8EE;
	background-color: #0E2A22D8;
	border-color: #36D8B28C;
}

.chip-status.on gametext
{
	text-decoration: none;
}

.chip-status.on .chip-dot
{
	background-color: #36D8B2;
	border-color: #36D8B2;
}

.accent-overline
{
	color: #D1FD04;
}


.persona-hero
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-bottom: 22dp;
	border-bottom: 1dp #898A8B28;
}

.persona-portrait
{
	position: relative;
	flex: 0 0 auto;
	width: 150dp;
	height: 150dp;
	background-color: #0E0F10DC;
	border: 1dp #898A8B3C;
}

.persona-rank-image
{
	display: block;
	width: 140dp;
	height: 140dp;
	margin: 4dp;
}

.persona-badge
{
	display: block;
	position: absolute;
	right: 0;
	bottom: 0;
	width: 54dp;
	height: 54dp;
	background-color: #0E0F10F0;
	border-top: 1dp #D1FD04;
	border-left: 1dp #D1FD04;
}

.persona-badge mappedimage
{
	display: block;
	width: 46dp;
	height: 46dp;
	margin: 4dp;
}

.persona-rank
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-left: 28dp;
}

.persona-rank-name
{
	display: block;
	margin-top: 4dp;
	font-size: 36dp;
	line-height: 44dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.persona-progress
{
	margin-top: 16dp;
	width: 70%;
}

.stat-blocks
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 8dp;
}

.stat-block
{
	display: block;
	box-sizing: border-box;
	width: 25%;
	padding: 14dp 16dp 12dp 0;
	border-bottom: 1dp #FFFFFF0A;
}

.stat-block-value
{
	display: block;
	font-size: 28dp;
	line-height: 34dp;
	font-weight: bold;
	color: #F1F2F3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.stat-block .stat-label
{
	display: block;
	margin-top: 2dp;
	letter-spacing: 0.5dp;
}


.fact
{
	display: block;
	min-width: 0;
}

.fact .stat-label
{
	letter-spacing: 0;
}

.fact-value
{
	display: block;
	margin-top: 2dp;
	font-size: 21dp;
	font-weight: bold;
	color: #F1F2F3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.detail-kind
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.detail-kind .chip-label
{
	margin: 0 8dp 4dp 0;
}


.screen .context-menu
{
	background-color: #0E0F10F5;
	border: 1dp #4D4E4F;
	min-width: 110dp;
	padding: 4dp 0;
}

.screen .context-menu-item
{
	height: 36dp;
	line-height: 36dp;
	padding: 0 18dp;
	text-align: left;
	border-bottom-width: 0;
	color: #DCDDDE;
}

.screen .context-menu-item:hover
{
	background-color: #3D3E3FDC;
	color: #FFFFFF;
}


body.modal
{
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-color: #0E0F10B4;
}

body.modal.over-game
{
	background-color: #0E0F105A;
}


.modal-scrim
{
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: 10;
	background-color: #0E0F10B4;
}

.modal-card
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	width: 640dp;
	max-height: 90%;
	background-color: #0E0F10F2;
	border: 1dp #898A8B3A; 
	border-top: 3dp #777879;
	animation: 0.18s cubic-out modal-in;
}

@keyframes modal-in
{
	from { opacity: 0; margin-top: 24dp; }
	to { opacity: 1; margin-top: 0dp; }
}

.modal-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	padding: 24dp 28dp 0 28dp;
}

.modal-heading
{
	display: block;
	flex: 1 1 auto;
	min-width: 0;
}

.modal-head .overline
{
	margin: 0 0 6dp 19dp;
}

.modal-title
{
	display: block;
	font-size: 30dp;
	line-height: 38dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #FFFFFF;
	border-left: 4dp #D1FD04;
	padding-left: 15dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}


.screen button.modal-close
{
	flex: 0 0 auto;
	width: 44dp;
	height: 44dp;
	line-height: 40dp;
	padding: 0;
	margin-left: 16dp;
	text-align: center;
	font-size: 28dp;
	color: #B1B2B3;
	background-color: transparent;
	border-color: transparent;
}

.screen button.modal-close:hover
{
	color: #FFFFFF;
	background-color: #3D3E3F78;
	border-color: transparent;
}

.modal-body
{
	display: block;
	flex: 1 1 auto;
	min-height: 0;
	padding: 22dp 28dp 26dp 28dp;
	color: #DCDDDE;
	line-height: 28dp;
}

.modal-actions
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	padding: 18dp 28dp;
	background-color: #0E0F10C8;
	border-top: 1dp #898A8B1E;
}

.modal-actions button
{
	margin-left: 12dp;
}

.modal-actions button:first-child
{
	margin-left: 0;
}

.screen .modal-actions button.btn-cta
{
	height: 54dp;
	line-height: 50dp;
	min-width: 200dp;
	padding: 0 36dp;
	font-size: 21dp;
}

.screen .modal-actions button.btn-back
{
	height: 50dp;
	line-height: 25dp;
	font-size: 19dp;
	background-color: transparent;
}

.screen .modal-actions button.btn-back:hover
{
	background-color: #28292AE6;
}


.modal-card.danger
{
	border-top-color: #FF5050;
}

.modal-card.danger .modal-title
{
	border-left-color: #FF5050;
}

.screen .modal-card.danger .modal-actions button.btn-cta
{
	color: #FFFFFF;
	border-color: #F07878;
	decorator: vertical-gradient(#E04848 #B82E2E);
}

.screen .modal-card.danger .modal-actions button.btn-cta:hover
{
	color: #FFFFFF;
	border-color: #FFA0A0;
	decorator: vertical-gradient(#F05A5A #C83838);
}

.screen .modal-card.danger .modal-actions button.btn-cta:active
{
	color: #FFFFFF;
	border-color: #E04848;
	decorator: vertical-gradient(#A82828 #C03434);
}


.field
{
	display: block;
}

.field + .field, .field + .checks, .checks + .field
{
	margin-top: 20dp;
}

.field .overline
{
	margin-bottom: 8dp;
}

.field .text-input
{
	display: block;
	box-sizing: border-box;
	width: 100%;
}


.checks
{
	display: block;
}

.checks label.check
{
	height: 40dp;
}


.screen.dock-open .screen-frame
{
	margin-right: 390dp;
}

.shell.dock-open .shell-frame
{
	width: auto;
	right: 5.6%;
	margin-right: 402dp;
}


@media (max-aspect-ratio: 3/2)
{
	.screen.dock-open .screen-frame { margin-right: 340dp; }
	.hq.dock-open .screen-frame > .action-bar { right: -340dp; }
	.shell.dock-open .shell-frame { margin-right: 352dp; }
}





.hq-band
{
	display: block;
	position: absolute;
	left: 40dp;
	right: 40dp;
	box-sizing: border-box;
	z-index: 4;
}

.hq-band-in
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 100%;
	padding: 0 20dp;
}


.hq-header
{
	top: 0;
	height: 96dp;
}


.hq-logo
{
	flex: 0 0 auto;
	width: 256dp;
	height: 83dp;
}


.mm-d .hq-logo
{
	align-self: flex-start;
	width: 370dp;
	height: 120dp;
	margin-top: 10dp;
}

.hq-heading
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 1 auto;
	min-width: 0;
	height: 44dp;
	margin-left: 22dp;
	padding-left: 26dp;
	border-left: 1dp #898A8B38;
}

.hq-crumb
{
	flex: 0 0 auto;
	margin-right: 16dp;
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #B1B2B3;
}

.hq-title
{
	flex: 0 1 auto;
	min-width: 0;
	font-size: 34dp;
	line-height: 40dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	color: #FFFFFF;
	border-left: 4dp #D1FD04;
	padding-left: 14dp;
}


.hq-aside
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-left: auto;
}

.hq-aside > *
{
	margin-left: 10dp;
}

.screen .hq-aside > button
{
	height: 42dp;
	line-height: 40dp;
	padding: 0 18dp;
	font-size: 16dp;
	letter-spacing: 2dp;
	color: #C0C1C2;
	background-color: #151617;
	border: 1dp #898A8B40;
}

.screen .hq-aside > button:hover
{
	color: #D1FD04;
	background-color: #1B1C1DE6;
	border-color: #D1FD04;
}

.hq-status
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-left: auto;
}

.hq-aside + .hq-status
{
	margin-left: 20dp;
	padding-left: 20dp;
	border-left: 1dp #898A8B38;
}

.hq-pill
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 38dp;
	padding: 0 18dp 0 16dp;
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #F1F2F3;
	background-color: #151617;
	border: 1dp #898A8B40;
}

.hq-dot
{
	display: inline-block;
	width: 10dp;
	height: 10dp;
	border-radius: 5dp;
	margin-right: 12dp;
	background-color: #36D8B2;
}

.hq-off
{
	color: #7A7B7C;
	background-color: transparent;
	border-color: #898A8B24;
}

.hq-off .hq-dot
{
	background-color: transparent;
	border: 2dp #646566;
}

.hq-sep
{
	display: inline-block;
	width: 1dp;
	height: 18dp;
	margin: 0 14dp;
	background-color: #898A8B50;
}

.hq-name
{
	color: #D1FD04;
	letter-spacing: 1dp;
	text-transform: none;
	font-size: 18dp;
}

.hq-clock
{
	margin-left: 20dp;
	padding-left: 20dp;
	border-left: 1dp #898A8B38;
	height: 38dp;
	line-height: 38dp;
	font-size: 24dp;
	font-weight: bold;
	letter-spacing: 3dp;
	color: #B1B2B3;
}


@media (max-aspect-ratio: 3/2)
{
	body.hq .hq-logo { width: 222dp; height: 72dp; }
	body.hq .hq-heading { margin-left: 16dp; padding-left: 18dp; }
	body.hq .hq-title { font-size: 30dp; }
	body.hq .hq-count, body.hq .hq-sep { display: none; }
	body.hq .hq-clock { margin-left: 14dp; padding-left: 14dp; font-size: 22dp; letter-spacing: 2dp; }
}


.hq-ticker
{
	bottom: 0;
	height: 72dp;
}

.hq-tag
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 42dp;
	padding-right: 20dp;
	margin-right: 4dp;
	border-right: 1dp #898A8B38;
	font-size: 14dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #D1FD04;
}

.hq-tag .hq-dot
{
	width: 8dp;
	height: 8dp;
	border-radius: 4dp;
	margin-right: 10dp;
}


.hq-tk-view
{
	display: block;
	position: relative;
	flex: 1 1 0%;
	min-width: 0;
	height: 42dp;
	overflow: hidden;
	clip: always;
}

.hq-tk-slide
{
	display: block;
	position: absolute;
	top: 0;
	left: 100%;
	width: 30000dp;
	height: 42dp;
	animation: 80s linear infinite ticker-slide;
}

.hq-tk-track
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	white-space: nowrap;
}

.hq-tk-run
{
	display: block;
	position: relative;
	left: 0%;
	line-height: 42dp;
	font-size: 17dp;
	color: #D0D1D2;
	animation: 80s linear infinite ticker-run;
}

@keyframes ticker-slide
{
	from { left: 100%; }
	to { left: 0%; }
}

@keyframes ticker-run
{
	from { left: 0%; }
	to { left: -100%; }
}


.hq-tk-fade
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 48dp;
	decorator: horizontal-gradient(#0E0F10D0 #0E0F1000);
}

.hq-tk-item
{
	margin-left: 26dp;
	padding-left: 26dp;
	border-left: 2dp #898A8B60;
}

.hq-tk-static
{
	flex: 1 1 auto;
	font-size: 15dp;
	letter-spacing: 1dp;
	white-space: nowrap;
	color: #7A7B7C;
}


.hq-brackets
{
	position: relative;
}

.hq-br
{
	display: block;
	position: absolute;
	width: 14dp;
	height: 14dp;
	border-color: #D1FD04;
	opacity: 0;
	transition: opacity 0.12s cubic-out;
}

.hq-br-tl { left: 0; top: 0; border-left-width: 2dp; border-top-width: 2dp; }
.hq-br-tr { right: 0; top: 0; border-right-width: 2dp; border-top-width: 2dp; }
.hq-br-bl { left: 0; bottom: 0; border-left-width: 2dp; border-bottom-width: 2dp; }
.hq-br-br { right: 0; bottom: 0; border-right-width: 2dp; border-bottom-width: 2dp; }


.hq-scan
{
	display: block;
	position: absolute;
	left: 0;
	bottom: 4dp;
	width: 0%;
	height: 2dp;
	decorator: horizontal-gradient(#D1FD04 #D1FD0400);
	transition: width 0.22s cubic-out;
}

.hq-brackets:hover .hq-br, .hq-brackets:focus-visible .hq-br { opacity: 1; }
.hq-brackets:hover .hq-scan { width: 70%; }


.hq-brackets.current .hq-br, .hq-brackets.selected .hq-br { opacity: 0.55; }
.hq-brackets.current .hq-scan, .hq-brackets.selected .hq-scan { width: 70%; }
.hq-brackets.current:hover .hq-br, .hq-brackets.selected:hover .hq-br { opacity: 1; }


.hq-section
{
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #C0C1C2;
}


.screen button.hq-card, .hq-card
{
	display: block;
	position: relative;
	box-sizing: border-box;
	height: auto;
	line-height: 1.2;
	padding: 0;
	text-align: left;
	text-transform: none;
	white-space: normal;
	color: #F1F2F3;
	background-color: #0E0F10EC;
	border: 1dp #898A8B3A;
	transition: border-color 0.12s cubic-out;
}

.screen button.hq-card:hover, .screen button.hq-card:focus-visible
{
	background-color: #111213F0;
	border-color: #D1FD04;
}

.screen button.hq-card:active
{
	background-color: #1B1C1DF0;
	border-color: #A8CC00;
}

.hq-edge
{
	display: block;
	position: absolute;
	left: -1dp;
	right: -1dp;
	top: -1dp;
	height: 4dp;
	background-color: transparent;
	transition: background-color 0.12s cubic-out;
}

button.hq-card:hover .hq-edge, button.hq-card:focus-visible .hq-edge
{
	background-color: #D1FD04;
}

.hq-art
{
	display: block;
	position: relative;
	overflow: hidden;
	clip: always;
	background-color: #0F1011;
}

.hq-card-text
{
	display: block;
	padding: 16dp 18dp;
}

.hq-card-title
{
	display: block;
	font-size: 25dp;
	line-height: 30dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #FFFFFF;
	transition: color 0.12s cubic-out;
}

button.hq-card:hover .hq-card-title
{
	color: #D1FD04;
}

.hq-card-desc
{
	display: block;
	margin-top: 6dp;
	font-weight: normal;
	font-size: 16dp;
	line-height: 21dp;
	color: #B1B2B3;
}



.su-body
{
	align-items: flex-start;
}

.su-map-col
{
	flex: 0 0 440dp;
	width: 440dp;
	margin-right: 20dp;
}

.su-side
{
	width: 380dp;
	align-self: stretch;
}

.col-main.su-main
{
	align-self: stretch;
}


.su-hero
{
	padding: 16dp 18dp 18dp 18dp;
}

.su-hero .hq-section
{
	margin-bottom: 14dp;
}

.su-hero .map-frame
{
	width: 404dp;
	height: auto; 
}

.su-hero .map-missing
{
	height: 300dp;
}

.su-hero-info
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	margin-top: 14dp;
}

.su-map-name
{
	display: block;
	flex: 1 1 100%;
	font-size: 25dp;
	line-height: 30dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: normal;
}

.su-cap
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 30dp;
	margin-top: 10dp;
	padding: 0 12dp;
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 1.5dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #DCDDDE;
	background-color: #3D3E3F78;
}

.su-cap span
{
	margin-right: 6dp;
	color: #D1FD04;
}

.screen button.su-map-btn
{
	flex: 0 0 auto;
	margin: 10dp 0 0 auto;
}



.su-players
{
	display: flex;
	flex-direction: column;
	flex: 0 1 auto;
	min-height: 0;
	max-height: 100%;
	box-sizing: border-box;
	padding: 16dp 20dp 14dp 20dp;
}

.su-players-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 40dp;
	margin-bottom: 6dp;
}

.su-fill
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: auto;
}

.su-fill .overline
{
	margin-right: 10dp;
}

.screen .su-fill button, .screen .prow-add button
{
	height: 36dp;
	line-height: 34dp;
	padding: 0 12dp;
	margin-left: 6dp;
	font-size: 15dp;
	color: #B1B2B3;
	background-color: transparent;
	border: 1dp #898A8B3C;
}

.screen .su-fill button:hover, .screen .prow-add button:hover
{
	color: #FFFFFF;
	border-color: #D1FD04;
	background-color: #3D3E3F78;
}

.screen .su-fill button[disabled], .screen .su-fill button[disabled]:hover,
.screen .prow-add button[disabled], .screen .prow-add button[disabled]:hover
{
	color: #515253;
	background-color: transparent;
	border-color: #898A8B1E;
}

.su-fill button[disabled] .pc-plus, .prow-add button[disabled] .pc-plus
{
	color: #515253;
}

.su-list
{
	flex: 1 1 auto;
	min-height: 0;
}

.su-item
{
	display: block;
}


.su-group
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 30dp;
	margin: 12dp 0 2dp 0;
	font-size: 14dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #C0C1C2;
	border-bottom: 1dp #898A8B30;
}

.su-item:first-child .su-group
{
	margin-top: 0;
}

.su-group-no
{
	margin-left: 8dp;
	color: #D1FD04;
}


.su-fold
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 38dp;
	margin-top: 10dp;
	padding: 0 12dp;
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 1.5dp;
	text-transform: uppercase;
	color: #878889;
	background-color: #0E0F108C;
	border: 1dp #898A8B1E;
	transition: color border-color 0.12s cubic-out;
}

.su-fold:hover
{
	color: #FFFFFF;
	border-color: #898A8B60;
}

.su-fold-mark
{
	width: 18dp;
	margin-right: 6dp;
	font-size: 22dp;
	color: #898A8B;
}

.su-fold:hover .su-fold-mark
{
	color: #D1FD04;
}

.su-fold-count
{
	margin-left: 8dp;
	color: #B1B2B3;
}


.prow
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 58dp;
	margin-top: 6dp;
	padding: 0 10dp 0 10dp;
	background-color: #111213C8;
	border-left: 5dp #7A7B7C;
}

.prow.human
{
	background-color: #1A1B1CD2;
}

.prow.empty
{
	height: 50dp;
	background-color: #0E0F108C;
	border-left-color: #898A8B28;
}

.prow.unused
{
	opacity: 0.8;
}

.prow > *
{
	flex: 0 0 auto;
}


.screen button.prow-chip
{
	box-sizing: border-box;
	width: 32dp;
	height: 32dp;
	line-height: 26dp;
	padding: 0;
	margin-right: 10dp;
	font-size: 16dp;
	text-align: center;
	color: #B1B2B3;
	border: 2dp #FFFFFF46;
	transition: border-color 0.12s cubic-out;
}

.screen button.prow-chip:hover, .screen button.prow-chip.open
{
	border-color: #D1FD04;
}

.screen button.prow-chip[disabled], .screen button.prow-chip[disabled]:hover
{
	border-color: #FFFFFF1E;
}

.prow-no
{
	width: 32dp;
	margin-right: 10dp;
	text-align: center;
	font-size: 18dp;
	font-weight: bold;
	color: #7A7B7C;
}

.prow-badge
{
	display: block;
	box-sizing: border-box;
	width: 42dp;
	height: 42dp;
	margin-right: 12dp;
	line-height: 40dp;
	text-align: center;
	font-size: 22dp;
	font-weight: bold;
	color: #7A7B7C;
	background-color: #0E0F10DC;
	border: 1dp #898A8B28;
}

.prow-badge mappedimage
{
	display: block;
	width: 34dp;
	height: 34dp;
	margin: 3dp;
}

.prow-who
{
	display: block;
	width: 200dp;
	min-width: 0;
	margin-right: 10dp;
}

.prow-who select
{
	width: 100%;
}

.prow-name
{
	display: block;
	font-size: 21dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.prow-state
{
	display: block;
	font-size: 19dp;
	color: #B1B2B3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.prow > .prow-army
{
	flex: 1 1 0%;
	min-width: 0;
}

.prow-army select, .prow-army .army-ro
{
	width: 100%;
}

.prow .team-seg
{
	margin-left: 10dp;
}


.prow-spot
{
	box-sizing: border-box;
	width: 40dp;
	height: 36dp;
	margin-left: 10dp;
	line-height: 32dp;
	text-align: center;
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
	background-color: #0E0F10C8;
	border: 2dp #B1B2B3;
}

.prow-spot.random
{
	color: #7A7B7C;
	border-color: #898A8B46;
}


.prow-add
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: auto;
}

.prow-add .overline
{
	margin-right: 4dp;
}


.prow-sub
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 3dp;
}

.prow-sub > *
{
	margin-right: 6dp;
}

.prow-sub .chip-label
{
	padding: 1dp 7dp;
	font-size: 12dp;
	letter-spacing: 1dp;
}

.prow.human.net
{
	height: auto;
	min-height: 58dp;
	padding-top: 6dp;
	padding-bottom: 6dp;
}


.prow-pop
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin: 2dp 0 4dp 15dp;
	padding: 8dp 10dp;
	background-color: #0E0F10F5;
	border: 1dp #4D4E4F;
	border-top: 2dp #D1FD04;
	animation: 0.14s cubic-out pop-in;
}

@keyframes pop-in
{
	from { opacity: 0; margin-top: -6dp; }
	to { opacity: 1; margin-top: 2dp; }
}

.prow-pop .swatches
{
	flex: 0 0 auto;
}

.prow-pop-name
{
	margin-left: 12dp;
	font-size: 16dp;
	color: #B1B2B3;
	white-space: nowrap;
}


.su-rules .hq-section
{
	margin-bottom: 16dp;
}

.su-rules .opt-label
{
	display: block;
	margin: 0 0 8dp 0;
	font-size: 17dp;
	color: #B1B2B3;
}

.su-rules .cash-seg
{
	margin-bottom: 16dp;
}

.screen .su-rules .cash-seg button.seg-item
{
	flex: 1 1 0%;
	padding: 0 4dp;
	font-size: 17dp;
}

.su-speed
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 14dp;
}

.su-speed .opt-label
{
	flex: 0 0 auto;
	margin: 0 16dp 0 0;
}

.su-speed input.range
{
	flex: 1 1 0%;
}

.su-chips
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 14dp;
}

.su-chips .chip-status
{
	margin: 0 8dp 8dp 0;
}


.su-ready
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 1 auto;
	min-width: 0;
	height: 58dp;
	margin-right: 20dp;
	padding: 0 20dp 0 16dp;
	background-color: #0E0F10D9;
	border-left: 3dp #D1FD04;
	font-size: 17dp;
	font-weight: bold;
	letter-spacing: 1.5dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #D1FD04;
}

.su-ready .dot
{
	margin-right: 12dp;
	background-color: #D1FD04;
}


.su-ready.blocked
{
	height: auto;
	min-height: 58dp;
	max-height: 58dp;
	overflow: hidden;
	box-sizing: border-box;
	padding: 3dp 20dp 3dp 16dp;
	border-left-color: #E8D440;
	font-size: 16dp;
	letter-spacing: 0;
	text-transform: none;
	font-weight: normal;
	color: #F1F2F3;
}

.su-blockers
{
	display: block;
	min-width: 0;
}

.su-blocker
{
	display: flex;
	flex-direction: row;
	align-items: center;
	line-height: 17dp;
	white-space: nowrap;
}

.su-blocker-mark
{
	flex: 0 0 auto;
	width: 15dp;
	height: 15dp;
	margin-right: 10dp;
	line-height: 15dp;
	text-align: center;
	font-size: 14dp;
	font-weight: bold;
	color: #1A1604;
	background-color: #E8D440;
}

.su-blocker span
{
	overflow: hidden;
	text-overflow: ellipsis;
}


@media (max-aspect-ratio: 3/2)
{
	.su-map-col { flex-basis: 330dp; width: 330dp; }
	.su-hero { padding: 14dp 14dp 16dp 14dp; }
	.su-hero .map-frame { width: 302dp; }
	.su-map-name { font-size: 22dp; line-height: 27dp; }
	.su-side { width: 300dp; }
	.su-players { padding: 14dp 14dp 12dp 14dp; }
	.su-fill .overline { display: none; }
	.screen .su-fill button { padding: 0 8dp; margin-left: 4dp; font-size: 14dp; }
	.prow { flex-wrap: wrap; height: auto; padding: 8dp 8dp 8dp 8dp; }
	.prow.empty { height: auto; }
	.prow-who { flex: 1 0 70%; width: auto; margin-right: 0; }
	.prow > .prow-army { flex: 1 1 0%; min-width: 150dp; margin: 8dp 0 0 42dp; }
	.prow .team-seg { margin-top: 8dp; }
	.prow-spot { margin-top: 8dp; }
	.screen .prow .team-seg button.seg-item { flex-basis: 28dp; width: 28dp; font-size: 15dp; }
	.screen .prow .team-seg button.seg-item:first-child { flex-basis: 48dp; width: 48dp; }
	.prow-badge { display: none; }
	.prow-add { flex: 1 1 100%; justify-content: flex-end; margin-top: 6dp; }
	.prow-add .overline { display: none; }
	.screen .prow-add button { padding: 0 8dp; margin-left: 4dp; font-size: 14dp; }
	.prow-pop { margin-left: 8dp; }
	.screen .prow-pop .swatches button.swatch { width: 26dp; height: 26dp; margin-right: 1dp; }
	.prow-pop .swatch .chip { line-height: 18dp; font-size: 13dp; }
	.prow-pop .swatch.random .chip { line-height: 16dp; }
	.prow-pop-name { display: none; }
	.su-ready { padding: 0 14dp 0 12dp; font-size: 15dp; margin-right: 14dp; }
	.su-ready.blocked { font-size: 14dp; }
}




body[dir=rtl]
{
	text-align: right;
}


body[dir=rtl] .pc-plus,
body[dir=rtl] .chat-time,
body[dir=rtl] .chat-name
{
	float: right;
}


body[lang^=zh]
{
	word-break: break-word;
}


body[dir=rtl] .progress-fill,
body[dir=rtl] .rank-progress-fill,
body[dir=rtl] .wc-army-fill
{
	margin-left: auto;
}
