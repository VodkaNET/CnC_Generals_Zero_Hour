


.honor-grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 10dp;
}

.honor-grid .stat
{
	flex: 0 0 50%;
	box-sizing: border-box;
	padding: 8dp 8dp 8dp 0;
}

.honor-grid .stat-value
{
	font-size: 28dp;
	line-height: 32dp;
}

.honor-grid .stat-label
{
	font-size: 13dp;
	letter-spacing: 0.5dp;
}

@media (max-aspect-ratio: 3/2)
{
	.honor-grid .stat-value { font-size: 24dp; line-height: 28dp; }
	.honor-grid .stat-label { font-size: 12dp; letter-spacing: 0; }
}
