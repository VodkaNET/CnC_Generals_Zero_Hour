

body.ld
{
	background-color: #0E0F10;
}



.ld-art
{
	display: block;
	position: absolute;
	left: 50%;
	top: 0;
	width: 100vw;
	margin-left: -50vw;
	height: 100%;
	overflow: hidden;
	clip: always;
	background-color: #0E0F10;
}


.ld-map-art
{
	display: block;
	position: absolute;
	left: 0;
	top: 50%;
	width: 100vw;
	height: 100vw;
	margin-top: -50vw;
	opacity: 0.9;
}


.ld-fallback-art
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100vw;
	height: 100vh;
}


.ld-cover-art
{
	display: block;
	position: absolute;
	left: 0;
	top: 50%;
	width: 100vw;
	height: 75vw;
	margin-top: -37.5vw;
}

.ld-movie
{
	display: block;
	position: absolute;
	left: 50%;
	top: 0;
	width: 100vw;
	margin-left: -50vw;
	height: 100%;
	background-color: #000000;
}

.ld-movie video
{
	display: block;
	width: 100%;
	height: 100%;
}


.ld-scrim
{
	display: block;
	position: absolute;
	left: 50%;
	top: 0;
	width: 100vw;
	margin-left: -50vw;
	height: 100%;
	decorator: vertical-gradient(#0E0F1059 #0E0F10D9);
}


.ld-frame
{
	display: flex;
	flex-direction: column;
}

.ld-head
{
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	flex: 0 0 auto;
	padding-top: 10dp;
}

.ld-heading
{
	display: block;
	flex: 0 1 auto;
	min-width: 0;
	padding: 14dp 30dp 16dp 22dp;
	background-color: #0E0F10D9;
	border-left: 4dp #D1FD04;
}

.ld-mode
{
	font-size: 17dp;
	letter-spacing: 3dp;
}

.ld-title
{
	display: block;
	margin-top: 4dp;
	font-size: 56dp;
	line-height: 64dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ld-title-small
{
	font-size: 32dp;
	line-height: 40dp;
	text-transform: none;
}

.ld-loading
{
	display: block;
	margin-top: 6dp;
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 3dp;
	color: #B1B2B3;
}

.ld-timeout
{
	padding: 10dp 20dp;
	font-size: 24dp;
	font-weight: bold;
	color: #D1FD04;
	background-color: #0E0F10D9;
}


.ld-general
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 1 620dp;
	min-width: 0;
	margin-left: 30dp;
	padding: 12dp 20dp 12dp 12dp;
	background-color: #0E0F10D9;
}

.ld-portrait
{
	display: block;
	flex: 0 0 auto;
	width: 124dp;
	height: 124dp;
	margin-right: 18dp;
}

.ld-portrait mappedimage
{
	display: block;
	width: 124dp;
	height: 124dp;
}

.ld-general-text
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.ld-general-name
{
	display: block;
	font-size: 28dp;
	font-weight: bold;
	color: #FFFFFF;
}

.ld-general-features
{
	display: block;
	margin-top: 6dp;
	font-size: 18dp;
	line-height: 24dp;
	color: #B1B2B3;
}


.ld-mid
{
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	flex: 1 1 0%;
	min-height: 0;
	padding: 20dp 0;
}

.ld-map-card
{
	padding: 12dp;
	border-top: 2dp #898A8B46;
}

.ld-map-frame
{
	width: 340dp;
	height: 340dp;
}


.ld-cards
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
}

.ld-card
{
	display: block;
	box-sizing: border-box;
	flex: 0 1 400dp;
	min-width: 0;
	margin-right: 12dp;
	padding: 14dp 16dp 16dp 16dp;
	background-color: #0E0F10EB;
	border-top: 5dp #7A7B7C;
}

.ld-card-top
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 10dp;
}

.ld-badge
{
	margin-right: 10dp;
}

.ld-rank, .ld-medal
{
	display: block;
	flex: 0 0 auto;
	width: 40dp;
	height: 40dp;
	margin-right: 8dp;
}

.ld-rank mappedimage, .ld-medal mappedimage
{
	display: block;
	width: 40dp;
	height: 40dp;
}

.ld-army-line
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 2dp;
}

.ld-team
{
	flex: 0 1 auto;
	min-width: 0;
	margin-left: 8dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ld-name
{
	display: block;
	font-size: 23dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ld-army
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	font-size: 17dp;
	color: #B1B2B3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ld-stats
{
	display: flex;
	flex-direction: row;
	margin-top: 8dp;
}

.ld-stat
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 18dp;
	font-weight: bold;
	color: #F1F2F3;
	white-space: nowrap;
	overflow: hidden;
}

.ld-stat-label
{
	display: block;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	font-size: 12dp;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #7A7B7C;
}

.ld-player-bar
{
	margin-top: 12dp;
	height: 14dp;
	padding: 2dp;
}

.ld-player-bar .progress-fill
{
	decorator: none;
	border-right: 2dp #FFFFFF;
}

.ld-player-bar.invisible
{
	visibility: hidden;
}


.ld-bottom
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	padding: 16dp 22dp;
	background-color: #0E0F10D9;
}

.ld-bottom-label
{
	flex: 0 0 auto;
	margin-right: 22dp;
	font-size: 17dp;
	letter-spacing: 3dp;
	color: #DCDDDE;
}

.ld-bar
{
	flex: 1 1 0%;
	height: 26dp;
	padding: 4dp;
}


.ld-bar.center1 .progress-fill { decorator: vertical-gradient(#FF7070 #C00000); border-right-color: #FFD0D0; }
.ld-bar.center2 .progress-fill { decorator: vertical-gradient(#A7A8A9 #4F5051); border-right-color: #E1E2E3; }
.ld-bar.center3 .progress-fill { decorator: vertical-gradient(#8CF57E #2A9A1E); border-right-color: #D6FFD0; }

.ld-legal
{
	display: block;
	flex: 0 0 auto;
	margin-bottom: 12dp;
	text-align: center;
	font-size: 14dp;
	color: #B1B2B3;
}



.ls-stage-wrap
{
	display: flex;
	flex-direction: row;
	justify-content: center;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.ls-stage
{
	position: relative;
	flex: 0 0 auto;
	width: 1440dp;
	max-width: 100%;
	height: 100%;
}


@media (max-aspect-ratio: 3/2)
{
	.ld-title { font-size: 44dp; line-height: 52dp; }
	.ld-general { flex-basis: 480dp; }
	.ld-portrait, .ld-portrait mappedimage { width: 96dp; height: 96dp; }
	.ld-general-features { font-size: 16dp; line-height: 21dp; }
	.ld-card { padding: 12dp 10dp 12dp 10dp; margin-right: 8dp; }
	.ld-name { font-size: 19dp; }
	.ld-army { font-size: 15dp; }
	.ld-badge { flex-basis: 44dp; width: 44dp; height: 44dp; line-height: 42dp; margin-right: 8dp; }
	.ld-badge mappedimage { width: 36dp; height: 36dp; }
	.ld-rank, .ld-medal, .ld-rank mappedimage, .ld-medal mappedimage { width: 30dp; height: 30dp; }
	.ld-rank, .ld-medal { margin-right: 6dp; }
}


@media (min-aspect-ratio: 3/2) and (max-aspect-ratio: 8/5)
{
	.ld-card { padding: 12dp 10dp 12dp 10dp; margin-right: 8dp; }
	.ld-badge { flex-basis: 44dp; width: 44dp; height: 44dp; line-height: 42dp; margin-right: 8dp; }
	.ld-badge mappedimage { width: 36dp; height: 36dp; }
	.ld-rank, .ld-medal, .ld-rank mappedimage, .ld-medal mappedimage { width: 30dp; height: 30dp; }
	.ld-rank, .ld-medal { margin-right: 6dp; }
}

.ld-bottom-mode
{
	flex: 0 0 auto;
	margin-right: 18dp;
	padding-right: 18dp;
	font-size: 17dp;
	letter-spacing: 3dp;
	border-right: 1dp #898A8B46;
}

.ld-concept .ld-art { pointer-events: none; }
.ld-concept .ld-heading { border-left-color: #C8C9CA; background-color: #1B1C1EEB; }
.ld-concept .ld-mode { color: #C8C9CA; }
.ld-concept .ld-title { font-size: 44dp; line-height: 52dp; }
.ld-concept .ld-general
{
    align-items: flex-start;
    flex-basis: 560dp;
    padding: 20dp;
    background-color: #1B1C1EEB;
    border: 1dp #454648B0;
    border-radius: 0dp;
}
.ld-concept .ld-portrait, .ld-concept .ld-portrait mappedimage { width: 96dp; height: 96dp; }
.ld-general-features { white-space: normal; }
.ld-feature-line { display: flex; flex-direction: row; align-items: flex-start; margin-top: 5dp; }
.ld-feature-line span { white-space: normal; }
.ld-feature-bullet { flex: 0 0 14dp; color: #C8C9CA; }
.ld-concept .ld-general-features { font-size: 16dp; line-height: 22dp; color: #B5B6B8; }
.ld-concept .ld-mid { align-items: center; }
.ld-concept .ld-map-card { flex: 0 0 auto; background-color: #1B1C1EEB; border: 1dp #454648B0; border-radius: 0dp; }
.ld-concept .ld-map-frame { width: 300dp; height: 300dp; }
.ld-tip-card
{
    display: block;
    flex: 0 1 880dp;
    min-width: 0;
    max-height: 100%;
    overflow: auto;
    padding: 26dp;
    margin-right: 28dp;
    box-sizing: border-box;
    background-color: #1B1C1EEB;
    border: 1dp #454648B0;
    border-radius: 0dp;
}
.ld-tip-faction { display: block; font-size: 14dp; line-height: 20dp; letter-spacing: 2dp; color: #C8C9CA; }
.ld-tip-heading { display: flex; flex-direction: row; align-items: center; margin-top: 16dp; }
.ld-tip-icon { flex: 0 0 auto; width: 88dp; height: 66dp; margin-right: 20dp; }
.ld-tip-icon mappedimage { display: block; width: 100%; height: 100%; }
.ld-tip-title { flex: 1 1 0%; min-width: 0; font-size: 30dp; line-height: 38dp; font-weight: normal; color: #F2F2F0; }
.ld-tip-cost { margin-left: 20dp; font-size: 24dp; line-height: 32dp; color: #F2F2F0; }
.ld-tip-advice { display: block; margin-top: 18dp; font-size: 20dp; line-height: 29dp; color: #E0E2E8; white-space: pre-line; }
.ld-tip-game { display: block; margin-top: 22dp; padding-top: 16dp; border-top: 1dp #454648B0; }
.ld-tip-game-label { display: block; font-size: 12dp; line-height: 18dp; letter-spacing: 1dp; color: #C8C9CA; }
.ld-tip-description { display: block; margin-top: 8dp; font-size: 16dp; line-height: 24dp; color: #B5B6B8; white-space: pre-line; }
@media (max-aspect-ratio: 3/2)
{
    .ld-concept .ld-title { font-size: 34dp; line-height: 42dp; }
    .ld-concept .ld-general { flex-basis: 460dp; }
    .ld-concept .ld-map-frame { width: 240dp; height: 240dp; }
    .ld-tip-card { padding: 20dp; margin-right: 20dp; }
    .ld-tip-title { font-size: 25dp; line-height: 32dp; }
    .ld-tip-advice { font-size: 18dp; line-height: 26dp; }
}

.ld-tip-author
{
    display: block;
    margin-top: 16dp;
    font-family: "Exo 2";
    font-weight: bold;
    font-size: 12dp;
    line-height: 18dp;
    letter-spacing: 1dp;
    text-align: right;
    color: #9FA1A4;
}

.ld-tip-model
{
    display: block;
    flex: 0 1 440dp;
    min-width: 180dp;
    height: 320dp;
    margin-right: 24dp;
    pointer-events: none;
}
@media (max-aspect-ratio: 3/2)
{
    .ld-tip-model { flex-basis: 280dp; min-width: 140dp; height: 240dp; margin-right: 12dp; }
    .ld-concept .ld-map-frame { width: 220dp; height: 220dp; }
}


.ld-concept .ld-art { z-index: 0; }
.ld-concept .screen-frame, .ld-concept .screen-ruler { z-index: 2; }
.ld-concept .ld-mid { align-items: center; }
.ld-model-backdrop
{
    display: block;
    position: absolute;
    left: 50%;
    margin-left: -12vw;
    top: 24vh;
    width: 60vw;
    height: 56vh;
    min-width: 0;
    margin-right: 0;
    pointer-events: none;
    z-index: 1;
}
.ld-concept .ld-map-dock
{
    display: block;
    position: absolute;
    right: 72dp;
    bottom: 116dp;
    width: 400dp;
    padding: 10dp;
    box-sizing: border-box;
    z-index: 2;
}
.ld-concept .ld-map-dock .ld-map-frame { width: 100%; height: 260dp; }
.ld-concept .ld-cards { margin-right: 440dp; }
@media (max-aspect-ratio: 3/2)
{
    .ld-concept .ld-map-dock { right: 40dp; width: 340dp; }
    .ld-concept .ld-map-dock .ld-map-frame { height: 220dp; }
    .ld-concept .ld-cards { margin-right: 360dp; }
    .ld-model-backdrop { margin-left: -14vw; width: 62vw; }
}

.ld-concept .ld-general-dock
{
    position: absolute;
    right: 72dp;
    top: 82dp;
    margin-left: 0;
    width: 600dp;
    box-sizing: border-box;
    z-index: 2;
}
.ld-card { position: relative; }
.ld-player-portrait
{
    display: block;
    position: absolute;
    right: 0;
    top: 0;
    width: 60%;
    height: 100%;
    opacity: 0.3;
    pointer-events: none;
    z-index: 0;
}
.ld-card-top, .ld-name, .ld-army-line, .ld-stats, .ld-player-bar { position: relative; z-index: 1; }
@media (max-aspect-ratio: 3/2)
{
    .ld-concept .ld-general-dock { right: 40dp; width: 460dp; }
}