

.bo-card
{
	width: 1040dp;
	height: 660dp;
	border-top: 2dp #4D4E4F;
}


.bo-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 72dp;
	padding: 0 16dp 0 24dp;
	border-bottom: 1dp #898A8B1E;
}

.head-icon
{
	display: block;
	width: 25dp;
	height: 25dp;
	margin-right: 13dp;
}

.icon-head
{
	display: block;
	width: 10dp;
	height: 10dp;
	margin: 0 auto 2dp auto;
	border-radius: 4dp;
	background-color: #B1B2B3;
}

.icon-body
{
	display: block;
	width: 20dp;
	height: 10dp;
	margin: 0 auto;
	border-radius: 10dp 10dp 0 0;
	background-color: #B1B2B3;
}

.bo-title
{
	font-size: 21dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #F1F2F3;
	white-space: nowrap;
	margin-right: 28dp;
}

.screen .bo-tabs button.seg-item
{
	min-width: 130dp;
}


.bo-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 0%;
	min-height: 0;
}

.bo-roster
{
	display: block;
	flex: 0 0 360dp;
	min-height: 0;
	overflow-y: auto;
	padding: 10dp 8dp 10dp 12dp;
	border-right: 1dp #898A8B1E;
}

.bo-person
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 60dp;
	padding: 0 10dp 0 12dp;
	border-left: 3dp transparent;
	transition: background-color 0.1s cubic-out;
}

.bo-person:hover
{
	background-color: #3D3E3F4B;
}


.bo-person.request
{
	border-left-color: #D1FD04;
	background-color: #D1FD0414;
}

.bo-presence
{
	display: block;
	flex: 0 0 12dp;
	width: 12dp;
	height: 12dp;
	margin-right: 14dp;
	border-radius: 6dp;
	background-color: #515253;
}

.bo-person.friend.online .bo-presence { background-color: #36D8B2; }
.bo-person.lobby .bo-presence { background-color: #959697; }
.bo-person.recent .bo-presence, .bo-person.request .bo-presence { background-color: #7A7B7C; }
.bo-person.blocked .bo-presence { background-color: #FF5050; }

.bo-who
{
	display: block;
	flex: 1 1 auto;
	min-width: 0;
}

.bo-name
{
	display: block;
	font-size: 20dp;
	line-height: 25dp;
	font-weight: bold;
	color: #F1F2F3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.bo-sub
{
	display: block;
	font-size: 16dp;
	line-height: 21dp;
	color: #B1B2B3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.bo-person.offline .bo-sub { color: #636465; }

.bo-unread
{
	display: block;
	flex: 0 0 auto;
	min-width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0 6dp;
	margin-left: 10dp;
	box-sizing: border-box;
	border-radius: 14dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #0E1400;
	background-color: #D1FD04;
}


.bo-thread
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-width: 0;
	min-height: 0;
	padding: 0 20dp 18dp 22dp;
}

.bo-thread-head
{
	display: block;
	flex: 0 0 auto;
	padding: 16dp 0 12dp 0;
	border-bottom: 1dp #898A8B1E;
}

.bo-thread-name
{
	font-size: 22dp;
	font-weight: bold;
	color: #F1F2F3;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.bo-lines
{
	display: block;
	flex: 1 1 0%;
	min-height: 0;
	margin-top: 10dp;
	padding-right: 10dp;
}

.bo-line
{
	display: block;
	padding: 4dp 0 4dp 12dp;
	border-left: 2dp #898A8B28;
	margin-bottom: 4dp;
	font-size: 18dp;
	line-height: 24dp;
}

.bo-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 12dp;
}

.bo-entry .chat-input
{
	flex: 1 1 auto;
	margin-right: 10dp;
}


.bo-blocked
{
	display: block;
	overflow-y: auto;
	padding: 10dp 12dp;
}

.bo-person.blocked .bo-name
{
	color: #FF8C8C;
}

@media (max-aspect-ratio: 3/2)
{
	.bo-card { width: 960dp; }
	.bo-roster { flex-basis: 320dp; }
}
