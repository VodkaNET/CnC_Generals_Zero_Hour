<rml>
	<head>
		<title>ScoreScreen</title>
		<link type="text/rcss" href="common.rcss"/>
		<link type="text/rcss" href="ScoreScreen.rcss"/>
	</head>
	<body class="screen hq ss" data-model="scorescreen">
		<loadbackdrop class="ss-art"></loadbackdrop>
		<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

		<div class="hq-band hq-header"><div class="hq-band-in">
				<mappedimage name="GeneralsLogo" class="hq-logo"/>
				<div class="hq-heading ss-heading" data-class-victory="is_victory" data-class-defeat="is_defeat"><div class="hq-crumb"><gametext key="GUI:SinglePlayer" data-if="mode == 0"/><gametext key="GUI:Skirmish" data-if="mode == 1"/><gametext key="GUI:Network" data-if="mode == 2"/><gametext key="GUI:GeneralsOnline" data-if="mode == 3"/><gametext key="GUI:LoadReplay" data-if="mode == 4"/><span class="crumb-sep">&#8250;</span></div><div class="hq-title"><gametext key="GUI:Victory" data-if="is_victory"/><gametext key="GUI:Defeat" data-if="is_defeat"/><gametext key="GUI:GameOver" data-if="!is_victory &amp;&amp; !is_defeat"/></div></div>
				<div class="hq-aside ss-match">
					<div class="ss-fact" data-if="map_name != ''">
						<div class="overline"><gametext key="GO:GUI:ScoreMap"/></div>
						<div class="ss-fact-value">{{map_name}}</div>
					</div>
					<div class="ss-fact">
						<div class="overline"><gametext key="GO:GUI:ScoreGameTime"/></div>
						<div class="ss-fact-value">{{game_time}}</div>
					</div>
				</div>
				<div class="hq-status">
					<div class="hq-pill" data-if="logged_in"><span class="hq-dot"></span><span class="hq-count" data-if="online_count_text != ''">{{online_count_text}}</span><span class="hq-sep" data-if="online_count_text != '' &amp;&amp; player_name != ''"></span><span class="hq-name" data-if="player_name != ''">{{player_name}}</span></div>
					<div class="hq-pill hq-off" data-if="!logged_in"><span class="hq-dot"></span><gametext key="GO:GUI:MenuOffline"/></div>
					<div class="hq-clock" data-if="clock_text != ''">{{clock_text}}</div>
				</div>
			</div></div>

		<div class="screen-frame">
			<!-- The outcome as the title, the game mode as the crumb, the map and game length beside it. -->

			<div class="screen-body">
				<div class="col col-main">
					<!-- Generals Challenge: the opponent's win or loss portrait and remarks instead of the table. -->
					<div class="surface ss-challenge" data-if="show_challenge_splash">
						<div class="ss-challenge-portrait"><mappedimage data-attr-name="challenge_portrait_image"/></div>
						<div class="ss-challenge-text">
							<div class="overline accent-overline"><gametext key="GUI:Generals_Challenge"/></div>
							<div class="ss-challenge-header">{{challenge_header_text}}</div>
							<div class="ss-challenge-remarks">{{challenge_remarks_text}}</div>
						</div>
					</div>

					<div class="ss-personal" data-if="!show_challenge_splash &amp;&amp; has_local_summary">
						<div class="ss-personal-title">Your Results</div>
						<div class="ss-summary-grid">
							<div class="ss-summary-item"><div class="ss-summary-label"><mappedimage class="ss-stat-icon" name="UnitDestroyed"/><gametext key="GUI:UnitsKilled"/></div><div class="ss-summary-value">{{local_kills}}</div></div>
							<div class="ss-summary-item"><div class="ss-summary-label"><mappedimage class="ss-stat-icon" name="UnitLost"/><gametext key="GUI:UnitsLost"/></div><div class="ss-summary-value">{{local_losses}}</div></div>
							<div class="ss-summary-item"><div class="ss-summary-label"><mappedimage class="ss-stat-icon" name="BuildingDestroyed"/><gametext key="GUI:BuildingsKilled"/></div><div class="ss-summary-value">{{local_buildings}}</div></div>
							<div class="ss-summary-item"><div class="ss-summary-label"><mappedimage class="ss-stat-icon" name="SuppliesCollected"/><gametext key="GUI:ResourcesCollected"/></div><div class="ss-summary-value">{{local_supplies}}</div></div>
						</div>
					</div>

					<div class="surface ss-table" data-if="!show_challenge_splash">
						<div class="ss-groups">
							<div class="ss-who"></div>
							<div class="ss-group">Units</div>
							<div class="ss-group ss-divider">Buildings</div>
							<div class="ss-group ss-group-supplies ss-divider">Supplies</div>
						</div>
						<div class="list-head ss-head">
							<div class="ss-who overline"><gametext key="GUI:PlayerName"/></div>
							<div class="ss-cell ss-header-stat" data-tooltip="GUI:UnitsBuilt"><mappedimage class="ss-stat-icon" name="UnitCreated"/><span>Created</span></div>
							<div class="ss-cell ss-header-stat" data-tooltip="GUI:UnitsLost"><mappedimage class="ss-stat-icon" name="UnitLost"/><span>Lost</span></div>
							<div class="ss-cell ss-header-stat" data-tooltip="GUI:UnitsKilled"><mappedimage class="ss-stat-icon" name="UnitDestroyed"/><span>Destroyed</span></div>
							<div class="ss-cell ss-header-stat ss-divider" data-tooltip="GUI:BuildingsBuilt"><mappedimage class="ss-stat-icon" name="BuildingCreated"/><span>Built</span></div>
							<div class="ss-cell ss-header-stat" data-tooltip="GUI:BuildingsLost"><mappedimage class="ss-stat-icon" name="BuildingLost"/><span>Lost</span></div>
							<div class="ss-cell ss-header-stat" data-tooltip="GUI:BuildingsKilled"><mappedimage class="ss-stat-icon" name="BuildingDestroyed"/><span>Destroyed</span></div>
							<div class="ss-cell ss-header-stat ss-divider" data-tooltip="GUI:ResourcesCollected"><mappedimage class="ss-stat-icon" name="SuppliesCollected"/><span>Collected</span></div>
						</div>
						<div class="scroll-container ss-rows">
							<div class="ss-row-slot" data-for="row : rows"><div class="ss-row" data-class-observer="row.is_observer" data-class-local="row.is_local" data-style-border-left-color="row.color_hex">
									<fadedportrait class="ss-player-portrait" data-if="row.portrait_image != ''" data-attr-name="row.portrait_image"></fadedportrait>
									<div class="ss-who">
										<div class="pc-badge ss-badge"><mappedimage data-if="row.badge_image != ''" data-attr-name="row.badge_image"/></div>
										<div class="ss-name-wrap">
											<div class="ss-name">{{row.display_name}}</div>
											<div class="ss-tags" data-if="row.is_victor || row.is_observer"><span class="chip-label good" data-if="row.is_victor"><gametext key="GUI:Victory"/></span><span class="chip-label" data-if="row.is_observer"><gametext key="GUI:Observer"/></span></div>
										</div>
									</div>

									<div class="ss-cell" data-class-best="row.best_units_built">{{row.units_built_text}}</div>
									<div class="ss-cell">{{row.units_lost_text}}</div>
									<div class="ss-cell" data-class-best="row.best_units_destroyed">{{row.units_destroyed_text}}</div>
									<div class="ss-cell ss-divider" data-class-best="row.best_buildings_built">{{row.buildings_built_text}}</div>
									<div class="ss-cell">{{row.buildings_lost_text}}</div>
									<div class="ss-cell" data-class-best="row.best_buildings_destroyed">{{row.buildings_destroyed_text}}</div>
									<div class="ss-cell ss-divider" data-class-best="row.best_money">{{row.money_earned_text}}</div>
								</div></div>
						</div>
					</div>
					<div class="surface ss-details" data-if="!show_challenge_splash &amp;&amp; mode == 3">
						<div class="ss-details-copy"><div class="ss-details-title">Match Details</div><div class="ss-match-id" data-if="match_id != ''">Match ID: {{match_id}}</div><div class="ss-details-note" data-if="match_id == ''">Online match data is unavailable for this game.</div></div>
						<button class="btn-small" data-if="match_id != ''" data-event-click="continue_pressed">View Match Online</button>
					</div>
				</div>

				<!-- Online and LAN: the tactical analysis and the post-game chat beside the results. -->
				<div class="col col-side ss-side" data-if="!show_challenge_splash &amp;&amp; ((show_academy_panel &amp;&amp; academy_advice.size > 0) || show_chat_log)">
					<div class="surface ss-academy" data-if="show_academy_panel &amp;&amp; academy_advice.size > 0">
						<div class="overline accent-overline"><gametext key="ACADEMY:Eva"/></div>
						<div class="scroll-container ss-academy-body">
							<div class="ss-tip" data-for="tip : academy_advice">{{tip}}</div>
						</div>
					</div>

					<div class="surface ss-chat" data-if="show_chat_log">
						<scrolllog class="scroll-container ss-chat-log">
							<div class="ss-chat-line" data-for="line : chat_lines">{{line}}</div>
						</scrolllog>
						<div class="ss-chat-entry send-row" data-if="show_chat_entry">
							<input type="text" class="chat-input" maxlength="128" data-value="chat_entry_text" data-event-change="chat_entry_committed"/>
							<button class="chat-send" data-event-click="send_chat"><span class="send-arrow"></span></button>
							<button class="chat-send emote" data-if="show_emote_button" data-event-click="send_emote" data-tooltip="TOOLTIP:EmoteButton"><span class="send-emote">*</span></button>
						</div>
					</div>
				</div>
			</div>

			<!-- Replay and communicator on the left; exit and continue on the right, the campaign's continue (the next mission) as the primary. -->
			<div class="action-bar">
				<button data-event-click="save_replay" data-attrif-disabled="!can_save_replay"><gametext key="GUI:SaveReplay"/></button>
				<button data-if="show_buddies_button" data-event-click="buddies"><gametext key="GUI:Buddies"/></button>
				<div class="ss-saved" data-if="show_save_game_text"><span class="dot"></span><gametext key="GUI:GameSaved"/></div>
				<div class="spacer"></div>
				<button data-if="mode == 0" data-event-click="ok"><gametext key="GUI:MainMenu"/></button>
				<button data-if="mode != 3 &amp;&amp; show_continue_button &amp;&amp; show_default_continue_label" data-class-btn-cta="mode == 0" data-event-click="continue_pressed"><gametext key="GUI:Continue"/></button>
				<button data-if="mode != 3 &amp;&amp; show_continue_button &amp;&amp; !show_default_continue_label" data-class-btn-cta="mode == 0" data-event-click="continue_pressed">{{continue_button_caption}}</button>
				<button class="btn-cta" data-if="mode != 0" data-event-click="ok"><gametext key="GUI:MainMenu"/></button>
			</div>
		</div>
	</body>
</rml>
